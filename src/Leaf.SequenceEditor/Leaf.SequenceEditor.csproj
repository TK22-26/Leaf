<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Same flag Leaf.AskPass uses to suppress the WinExe console-window flash
         when git invokes the helper. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <RootNamespace>Leaf.SequenceEditor</RootNamespace>
    <AssemblyName>Leaf.SequenceEditor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Leaf.Core\Leaf.Core.csproj" />
  </ItemGroup>

</Project>
