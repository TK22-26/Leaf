<!--
    NoteEditor (C6) — inline textarea overlay for attaching a user-authored
    note to a conflict range. Hosted in a Popup whose anchor comes from the
    speech-bubble glyph the user clicked; committed text flows back to the
    VM through CommitRequested. Enter commits, Escape cancels, Ctrl+Enter
    inserts a newline.
-->
<UserControl x:Class="Leaf.Controls.Merge.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="EditorRoot"
             AutomationProperties.AutomationId="Merge.NoteEditor">
    <Border CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource Merge.Border.Strong}"
            Background="{DynamicResource Merge.Surface.3}"
            Padding="10"
            MinWidth="320">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Note for this conflict"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Merge.Type.Caption.Size}"
                       Foreground="{DynamicResource Merge.Text.Secondary}"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="NoteInput"
                     AcceptsReturn="True"
                     MinHeight="60"
                     MaxHeight="200"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="{DynamicResource Merge.Type.Body.Size}"
                     Background="{DynamicResource Merge.Surface.2}"
                     Foreground="{DynamicResource Merge.Text.Primary}"
                     BorderBrush="{DynamicResource Merge.Border.Subtle}"
                     AutomationProperties.AutomationId="Merge.NoteEditor.Input"
                     KeyDown="OnInputKeyDown"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Cancel"
                        Click="OnCancelClicked"
                        Margin="0,0,6,0"
                        Padding="10,3"
                        AutomationProperties.AutomationId="Merge.NoteEditor.Cancel"/>
                <Button Content="Save"
                        Click="OnSaveClicked"
                        Padding="10,3"
                        IsDefault="True"
                        AutomationProperties.AutomationId="Merge.NoteEditor.Save"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
