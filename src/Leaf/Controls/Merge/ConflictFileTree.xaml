<!--
    ConflictFileTree (C4) — replaces the flat ListBox with a TreeView grouped
    by folder. Every node is a ConflictTreeNode (either a folder with
    children, or a file leaf wrapping a ConflictInfo).

    Each row shows:
      • FluentIcon — Folder16 for groups, Document16 for files
      • DisplayName — folder segment or file name
      • StatusPill — colored dot + count when UnresolvedCount > 0

    Folder nodes bind to HierarchicalDataTemplate.ItemsSource so WPF
    auto-recurses. The root TreeView's ItemsSource comes from the hosting
    VM's ConflictTree property.

    Selection: two-way SelectedFile DP surfaces only file-leaf selections;
    clicking a folder leaves SelectedFile unchanged. This keeps the current
    MergeEditorViewModel.SelectedConflict binding contract intact — the
    rest of the merge editor still receives ConflictInfo (not a node).
-->
<UserControl x:Class="Leaf.Controls.Merge.ConflictFileTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:conv="clr-namespace:Leaf.Converters"
             xmlns:vm="clr-namespace:Leaf.ViewModels.Merge"
             mc:Ignorable="d"
             x:Name="TreeRoot"
             Focusable="False">

    <UserControl.Resources>
        <conv:ProgressFillHeightConverter x:Key="ProgressFillHeightConverter"/>

        <!-- HierarchicalDataTemplate bound to ConflictTreeNode. Children is
             empty for file leaves, so WPF auto-terminates recursion. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:ConflictTreeNode}"
                                  ItemsSource="{Binding Children}">
            <!-- AutomationId on each row makes individual files / folders
                 addressable from Stagehand and assistive tech — the TreeView
                 itself only exposes a single AutomationId, so without this
                 clients would need to walk the visual tree to pick a row. -->
            <Grid AutomationProperties.AutomationId="{Binding FullPath, StringFormat='Merge.TreeRow.{0}'}"
                  AutomationProperties.Name="{Binding DisplayName}">
                <Grid.ColumnDefinitions>
                    <!-- Sublime-Merge-style accent stripe column. Sits on the
                         left edge of the row content (after the TreeView's
                         indent + chevron) so each file/folder gets a clear
                         "status rail" without competing with the filename
                         for attention. -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Accent progress stripe. Replaces the prior count pill
                     entirely: the stripe IS the indicator. The base layer
                     paints Merge.State.Unresolved (red) over the full
                     stripe rectangle; an inner Rectangle anchored to the
                     bottom paints Merge.State.Resolved (green) at a height
                     proportional to ResolvedRegionCount / TotalRegionCount.
                     As the user accepts conflict regions in the merge
                     editor the green portion grows from the bottom up,
                     turning the stripe into a per-file (and per-folder)
                     progress bar.

                     Reactivity: ConflictTreeNode forwards
                     ConflictInfo.ResolvedRegionCount changes for file
                     leaves and aggregates for folders, so the binding
                     refreshes the moment the editor's
                     NotifyResolutionCountsChanged writes a new count —
                     no tree rebuild required.

                     Geometry: fixed Height=14, Width=3, CornerRadius=1.5
                     for a slim crisp rail. SnapsToDevicePixels keeps the
                     rounded ends from picking up 1-px ovalisation at
                     fractional DPI scales. The stripe is hidden when
                     TotalRegionCount = 0 (defensive — file rows in the
                     tree always have ≥ 1 region). -->
                <Grid x:Name="StatusStripe"
                      Grid.Column="0"
                      Width="3" Height="14"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalRegionCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- Unresolved (red) base — covers the full stripe so
                         partially-resolved files show red at the top and
                         green at the bottom. -->
                    <Border CornerRadius="1.5"
                            Background="{DynamicResource Merge.State.Unresolved}"/>
                    <!-- Resolved (green) progress fill — anchored to bottom,
                         height = ratio * stripe height. Bottom-only corner
                         radius so the fill's top edge is a flat join into
                         the unresolved base. -->
                    <Border CornerRadius="0,0,1.5,1.5"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource Merge.State.Resolved}">
                        <Border.Height>
                            <MultiBinding Converter="{StaticResource ProgressFillHeightConverter}">
                                <Binding Path="ResolvedRegionCount"/>
                                <Binding Path="TotalRegionCount"/>
                                <Binding ElementName="StatusStripe" Path="ActualHeight"/>
                            </MultiBinding>
                        </Border.Height>
                    </Border>
                </Grid>

                <!-- One icon per row. Symbol is resolved once at node-
                     construction time (FileTypeIconResolver) so folders get
                     Symbol.Folder and file leaves get the per-extension glyph
                     (Code / Braces / Image / Document). Binding directly to
                     the node's IconSymbol keeps this surface simple — no
                     twin-SymbolIcon workaround, no visibility triggers. -->
                <ic:SymbolIcon Grid.Column="1"
                               Symbol="{Binding IconSymbol}"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Merge.Text.Secondary}"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Merge.Type.Body.Size}"
                           Foreground="{DynamicResource Merge.Text.Primary}"/>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <!-- VirtualizingStackPanel.IsVirtualizing="False" guarantees every
         TreeViewItem container is realized before we try to resolve
         selection + expansion state in code-behind. Conflict lists rarely
         exceed a few hundred files; the memory win from virtualization is
         not worth the state-tracking complexity. -->
    <TreeView x:Name="Tree"
              ItemsSource="{Binding ElementName=TreeRoot, Path=ItemsSource}"
              BorderThickness="0"
              Background="Transparent"
              VirtualizingStackPanel.IsVirtualizing="False"
              SelectedItemChanged="OnTreeSelectedItemChanged"/>

</UserControl>
