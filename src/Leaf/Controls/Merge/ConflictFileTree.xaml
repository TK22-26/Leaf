<!--
    ConflictFileTree (C4) — replaces the flat ListBox with a TreeView grouped
    by folder. Every node is a ConflictTreeNode (either a folder with
    children, or a file leaf wrapping a ConflictInfo).

    Each row shows:
      • FluentIcon — Folder16 for groups, Document16 for files
      • DisplayName — folder segment or file name
      • StatusPill — colored dot + count when UnresolvedCount > 0

    Folder nodes bind to HierarchicalDataTemplate.ItemsSource so WPF
    auto-recurses. The root TreeView's ItemsSource comes from the hosting
    VM's ConflictTree property.

    Selection: two-way SelectedFile DP surfaces only file-leaf selections;
    clicking a folder leaves SelectedFile unchanged. This keeps the current
    MergeEditorViewModel.SelectedConflict binding contract intact — the
    rest of the merge editor still receives ConflictInfo (not a node).
-->
<UserControl x:Class="Leaf.Controls.Merge.ConflictFileTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:vm="clr-namespace:Leaf.ViewModels.Merge"
             mc:Ignorable="d"
             x:Name="TreeRoot"
             Focusable="False">

    <UserControl.Resources>
        <!-- Local converter so the control works regardless of whether the
             host has registered a BooleanToVisibilityConverter at App level
             (tests running outside the Leaf app shell, design-time previewers). -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- HierarchicalDataTemplate bound to ConflictTreeNode. Children is
             empty for file leaves, so WPF auto-terminates recursion. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:ConflictTreeNode}"
                                  ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Folder icon — visible only when IsFolder. -->
                <ic:SymbolIcon Grid.Column="0"
                               Symbol="Folder" FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Merge.Text.Secondary}"
                               Visibility="{Binding IsFolder,
                                   Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- File icon — visible only when NOT IsFolder. Uses a
                     DataTrigger-less inverse-binding would need another
                     converter; simpler to use a sibling element with
                     opposite visibility via an InvertedBooleanToVisibility
                     converter provided by the host app. Here we use two
                     SymbolIcons with the bool-to-visibility converter and
                     an inverted one to avoid a new converter type. -->
                <ic:SymbolIcon Grid.Column="0"
                               Symbol="Document" FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Merge.Text.Secondary}">
                    <ic:SymbolIcon.Style>
                        <Style TargetType="{x:Type ic:SymbolIcon}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ic:SymbolIcon.Style>
                </ic:SymbolIcon>

                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Merge.Type.Body.Size}"
                           Foreground="{DynamicResource Merge.Text.Primary}"/>

                <!-- Status pill on the right. Only shown when UnresolvedCount
                     > 0; zero = fully resolved so no badge is needed (the
                     absence itself signals completion). Uses the shared
                     PillBg / PillText tokens from MergePaletteDark so the
                     pill reads consistently wherever it appears. -->
                <Border Grid.Column="2" Margin="8,0,2,0"
                        VerticalAlignment="Center"
                        Padding="6,1"
                        CornerRadius="8"
                        Background="{DynamicResource Merge.State.Unresolved.PillBg}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UnresolvedCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding UnresolvedCount}"
                               FontSize="{DynamicResource Merge.Type.CaptionStrong.Size}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Merge.State.Unresolved.PillText}"/>
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <!-- VirtualizingStackPanel.IsVirtualizing="False" guarantees every
         TreeViewItem container is realized before we try to resolve
         selection + expansion state in code-behind. Conflict lists rarely
         exceed a few hundred files; the memory win from virtualization is
         not worth the state-tracking complexity. -->
    <TreeView x:Name="Tree"
              ItemsSource="{Binding ElementName=TreeRoot, Path=ItemsSource}"
              BorderThickness="0"
              Background="Transparent"
              VirtualizingStackPanel.IsVirtualizing="False"
              SelectedItemChanged="OnTreeSelectedItemChanged"/>

</UserControl>
