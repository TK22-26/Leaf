<!--
    SegmentedAcceptPill — C2 replacement for the per-side accept checkboxes.
    Three cells (Ours | Both | Theirs) with exclusive selection; one click
    routes through the host-supplied ICommand for that cell with the conflict
    range index as CommandParameter. Replaces the ambiguous two-checkbox UX
    where clicking Ours while Theirs was accepted implied AcceptBoth.
-->
<UserControl x:Class="Leaf.Controls.Merge.SegmentedAcceptPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="PillRoot"
             Focusable="False"
             Height="18">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="Merge.PillCell">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Merge.Text.Secondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource Merge.Type.Caption.Size}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource Merge.Surface.4}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="OuterBorder"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{DynamicResource Merge.Border.Strong}"
            Background="{DynamicResource Merge.Surface.3}">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="OursCell"
                    Style="{StaticResource Merge.PillCell}"
                    Click="OnOursClicked"
                    ToolTip="Accept Ours (◄)"
                    AutomationProperties.AutomationId="Merge.Pill.Ours"
                    AutomationProperties.Name="Accept Ours">
                <TextBlock><Run Text="◄ "/><Run Text="Ours"/></TextBlock>
            </Button>
            <Border Width="1" Background="{DynamicResource Merge.Border.Strong}"/>
            <Button x:Name="BothCell"
                    Style="{StaticResource Merge.PillCell}"
                    Click="OnBothClicked"
                    ToolTip="Accept Both (◆)"
                    AutomationProperties.AutomationId="Merge.Pill.Both"
                    AutomationProperties.Name="Accept Both">
                <TextBlock><Run Text="◆ "/><Run Text="Both"/></TextBlock>
            </Button>
            <Border Width="1" Background="{DynamicResource Merge.Border.Strong}"/>
            <Button x:Name="TheirsCell"
                    Style="{StaticResource Merge.PillCell}"
                    Click="OnTheirsClicked"
                    ToolTip="Accept Theirs (►)"
                    AutomationProperties.AutomationId="Merge.Pill.Theirs"
                    AutomationProperties.Name="Accept Theirs">
                <TextBlock><Run Text="Theirs"/><Run Text=" ►"/></TextBlock>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
