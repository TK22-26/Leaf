<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Leaf.Controls">

    <BooleanToVisibilityConverter x:Key="DropdownBoolToVisConverter" />

    <Style TargetType="{x:Type controls:DropdownButton}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DropdownButton}">
                    <Grid>
                        <!--  We deliberately don't set a custom Style on
                              the ToggleButton — that lets the Fluent
                              theme's implicit ToggleButton template
                              apply naturally (background, border,
                              hover, pressed, checked). An earlier
                              attempt at BasedOn={StaticResource
                              {x:Type ToggleButton}} silently produced
                              a template-less ToggleButton because
                              StaticResource lookups inside a Source-
                              loaded ResourceDictionary don't see the
                              consumer's resource scope.  -->
                        <ToggleButton x:Name="PART_Button"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <!--  ComboBox-style layout: content left-aligned,
                                  chevron pinned to the far-right edge so
                                  the trigger reads as a dropdown affordance
                                  regardless of how wide the button stretches.  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <TextBlock x:Name="Chevron"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="8"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="&#xE70D;"
                                           RenderTransformOrigin="0.5,0.5"
                                           Visibility="{Binding ShowChevron, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DropdownBoolToVisConverter}}">
                                    <!--  Rotate animates between 0 (closed,
                                          chevron points down) and 180
                                          (open, chevron points up) on the
                                          IsDropdownOpen state change. The
                                          150ms duration matches the
                                          PopupAnimation="Slide" reveal so
                                          the chevron and popup move in
                                          lockstep.  -->
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </ToggleButton>

                        <!--  PopupAnimation="Slide" gives the menu the same
                              gentle reveal the Windows 11 Fluent menus use
                              — replaces the abrupt "appears" of the prior
                              ad-hoc popup.  -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_Button}"
                               PopupAnimation="Slide"
                               StaysOpen="False">
                            <Border MinWidth="160"
                                    Margin="0,2,0,0"
                                    Padding="4"
                                    Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}"
                                    BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Content="{Binding DropdownContent, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </Popup>
                    </Grid>

                    <!--  Animate the chevron rotation when the popup
                          opens / closes. EnterActions runs the rotate
                          forward to 180°; ExitActions runs it back to
                          0°. Targeting RenderTransform.Angle by name
                          requires the chevron's RotateTransform to be
                          registered — done above via x:Name targeting
                          via Storyboard.TargetName="Chevron" with the
                          property path drilling into RenderTransform.  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropdownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="180"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
