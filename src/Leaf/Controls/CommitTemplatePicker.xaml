<UserControl x:Class="Leaf.Controls.CommitTemplatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Leaf.Converters"
             FontFamily="Segoe UI Variable"
             Width="380"
             MaxHeight="420">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search box -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Margin="8,8,8,4"
                     Padding="6,4"
                     FontSize="12"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Tag" Value="Search templates…"/>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Result list -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Margin="4,0,4,4"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="ResultsList_KeyDown"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding PreviewLine}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    Padding="4,1"
                                    CornerRadius="3"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Badge}"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer hint -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SubtleFillColorTransparentBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    Padding="8,4">
                <TextBlock Text="↵ apply  ·  ⇧↵ append  ·  Esc close"
                           FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
