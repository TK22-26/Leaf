<UserControl
    x:Class="Leaf.Controls.NotificationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    Width="380"
    Opacity="0">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="SlideTransform" X="-400" />
    </UserControl.RenderTransform>

    <Border
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Direction="270"
                Opacity="0.3"
                ShadowDepth="4"
                Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Accent strip  -->
            <Border
                x:Name="AccentStrip"
                Grid.Column="0"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="8,0,0,8" />

            <!--  Icon  -->
            <ic:SymbolIcon
                x:Name="TypeIcon"
                Grid.Column="1"
                Width="20"
                Height="20"
                Margin="12,12,8,12"
                VerticalAlignment="Top"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Symbol="ErrorCircle" />

            <!--  Title + Description  -->
            <StackPanel
                Grid.Column="2"
                Margin="0,10,8,10"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="Error"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="DescriptionText"
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    MaxHeight="60"
                    Text=""
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Close button  -->
            <Button
                x:Name="CloseButton"
                Grid.Column="3"
                Width="28"
                Height="28"
                Margin="0,8,8,0"
                Padding="0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseButton_Click"
                Cursor="Hand"
                Focusable="False">
                <Button.Style>
                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="ButtonBorder"
                                        Background="Transparent"
                                        CornerRadius="4">
                                        <ic:SymbolIcon
                                            x:Name="DismissIcon"
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Symbol="Dismiss" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="DismissIcon" Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
