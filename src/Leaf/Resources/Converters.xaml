<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Leaf.Converters">

    <!--  Common Converters  -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    <converters:ContentModeToVisibilityConverter x:Key="ContentModeToVisibilityConverter" />
    <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />

    <!--  Pull Request Converters  -->
    <converters:PullRequestStateToColorConverter x:Key="PullRequestStateToColorConverter" />
    <converters:PullRequestStateToTextConverter x:Key="PullRequestStateToTextConverter" />
    <converters:CheckStatusToColorConverter x:Key="CheckStatusToColorConverter" />
    <converters:CheckStatusToIconConverter x:Key="CheckStatusToIconConverter" />
    <converters:ReviewStateToColorConverter x:Key="ReviewStateToColorConverter" />
    <converters:ReviewStateToTextConverter x:Key="ReviewStateToTextConverter" />
    <converters:MarkdownToFlowDocumentConverter x:Key="MarkdownToFlowDocumentConverter" />
    <converters:FileStatusToBrushConverter x:Key="FileStatusToBrushConverter" />
    <converters:IdenticonConverter x:Key="IdenticonConverter" />

    <!--  File Status Brushes  -->
    <SolidColorBrush x:Key="AddedBrush" Color="#00AA00" />
    <SolidColorBrush x:Key="DeletedBrush" Color="#DD3333" />
    <SolidColorBrush x:Key="ModifiedBrush" Color="#CCAA00" />
    <SolidColorBrush x:Key="RenamedBrush" Color="#6666DD" />
    <SolidColorBrush x:Key="ConflictBrush" Color="#FF6600" />

</ResourceDictionary>
