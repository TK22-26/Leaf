<!--
    Merge editor motion tokens.

    Two storyboards live here — the two whose targets are addressable WPF
    elements with animatable dependency properties:

      - Merge.Motion.MinimapJump — 400 ms smooth scroll of a ScrollViewer via
        an attached animated-offset DP. Consumed by MergeMotionHelpers.SmoothScrollTo.
      - Merge.Motion.PaneFocus   — 250 ms border-brush colour pulse. Consumed
        by MergeMotionHelpers.PulsePaneFocus on GotKeyboardFocus / LostKeyboardFocus.

    The other V5-era animations (range-resolve overlay fade, checkbox bounce,
    checkbox color crossfade) target elements that ReadOnlyMergePane draws
    directly inside OnRender rather than hosts as UIElements — Storyboards
    can't drive those without a retained visual tree per region. Those
    animations live in the pane as dispatcher-timer-driven pure-math tweens
    using the same 150/200/350 ms durations + ease-out-quadratic shape as the
    tokens here. Keeping the XAML focused on Storyboards that are genuinely
    consumable prevents dual-path scaffolding.

    PopoverShow will be added here when the first popover consumer lands
    (C5 blame peek or AI resolution popover); defining it pre-emptively
    would ship dead XAML.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <QuadraticEase x:Key="Merge.Motion.Ease" EasingMode="EaseOut"/>

    <Storyboard x:Key="Merge.Motion.MinimapJump">
        <DoubleAnimation Duration="0:0:0.4"
                         EasingFunction="{StaticResource Merge.Motion.Ease}"/>
    </Storyboard>

    <Storyboard x:Key="Merge.Motion.PaneFocus">
        <ColorAnimation Storyboard.TargetProperty="Color"
                        Duration="0:0:0.25"
                        EasingFunction="{StaticResource Merge.Motion.Ease}"/>
    </Storyboard>

</ResourceDictionary>
