<!--
    Merge editor motion tokens.

    Plan §D3 called for six named storyboards. Three ship here as Storyboards;
    the rest are either pure-math tweens (where a Storyboard can't target the
    surface) or genuinely deferred with documented rationale below.

    SHIPPED STORYBOARDS
    - Merge.Motion.MinimapJump  — 400 ms smooth scroll of a ScrollViewer via
      the AnimatedVerticalOffset attached DP on MergeMotionHelpers. Consumed
      by MergeMotionHelpers.SmoothScrollTo.
    - Merge.Motion.PaneFocus    — 250 ms border-brush colour pulse. Consumed
      by MergeMotionHelpers.PulsePaneFocusColour on GotKeyboardFocus.
    - Merge.Motion.AcceptButton — 150 ms scale 0.97 → 1.0 ease-out bounce on
      the clicked SegmentedAcceptPill cell. Consumed by
      MergeMotionHelpers.PlayAcceptBounce.

    DISPATCHER-TIMER TWEENS (not WPF Storyboards — same timing shape)
    - RangeResolve: 350 ms ease-out-quadratic background crossfade. Lives
      inside ReadOnlyMergePane because the region tints are painted through
      DrawingContext, which has no addressable element for a Storyboard
      to target. Timing parameters mirror this file to keep the motion
      budget coherent.

    DEFERRED (no consumer yet; adding the storyboard pre-emptively would
    ship dead XAML that the palette-flatten loader would have to realize
    on every test run)
    - Merge.Motion.CheckboxToggle — targeted the per-side accept checkbox
      that C2 removed. The replacement surface (SegmentedAcceptPill) uses
      AcceptButton for click feedback; there is no "toggle" per se because
      the pill is exclusive-selection.
    - Merge.Motion.PopoverShow   — fade + 2 px translateY for a popover.
      Waiting on the first popover consumer (C5 blame peek or AI proposal).
      Will be added here in the same commit that ships the popover.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <QuadraticEase x:Key="Merge.Motion.Ease" EasingMode="EaseOut"/>

    <Storyboard x:Key="Merge.Motion.MinimapJump">
        <DoubleAnimation Duration="0:0:0.4"
                         EasingFunction="{StaticResource Merge.Motion.Ease}"/>
    </Storyboard>

    <Storyboard x:Key="Merge.Motion.PaneFocus">
        <ColorAnimation Storyboard.TargetProperty="Color"
                        Duration="0:0:0.25"
                        EasingFunction="{StaticResource Merge.Motion.Ease}"/>
    </Storyboard>

    <!--  AcceptButton: parallel ScaleX + ScaleY animations from 0.97 to 1.0
          over 150 ms. Helper clones, sets target to a per-pill ScaleTransform,
          and begins. Two children so one storyboard drives both axes. -->
    <Storyboard x:Key="Merge.Motion.AcceptButton">
        <DoubleAnimation Duration="0:0:0.15" From="0.97" To="1.0"
                         EasingFunction="{StaticResource Merge.Motion.Ease}"/>
        <DoubleAnimation Duration="0:0:0.15" From="0.97" To="1.0"
                         EasingFunction="{StaticResource Merge.Motion.Ease}"/>
    </Storyboard>

</ResourceDictionary>
