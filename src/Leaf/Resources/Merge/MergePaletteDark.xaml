<!--
    Merge editor dark-theme palette.

    Provides both the Color tokens (consumed by code that needs the raw ARGB,
    e.g. LinearGradientBrush construction) and the SolidColorBrush tokens
    (consumed by XAML). V8's MergePaletteLight.xaml is a parallel file with
    light-theme values; ThemeService swaps this dict for that one at runtime.

    Why inline Color values on each brush instead of {DynamicResource} indirection:
    cross-thread WPF DP access. Brushes with a DynamicResource-backed Color DP
    are bound to the thread they were parsed on; swapping the Dark dict for the
    Light dict cleanly updates the brushes through the lookup-by-key mechanism
    without any cross-thread hops.

    All text/background pairs verified >= WCAG AA (4.5:1) contrast against
    Merge.Surface.2 (the pane background).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Ours (blue side). BgSubtle bumped from 0x1A→0x55 alpha and the
          base hue brightened from #2B4A6E (washed-out navy) to #4A8FE0
          (cleaner blue) so region tints in the input panes read as
          deliberate blue blocks rather than barely-perceptible smudges.
          Text remains legible because the alpha is still well below
          BgStrong (used for hover swap / inline pill backgrounds).  -->
    <Color x:Key="Merge.Ours.BgSubtle.Color">#554A8FE0</Color>
    <Color x:Key="Merge.Ours.BgStrong.Color">#992B4A6E</Color>
    <Color x:Key="Merge.Ours.Accent.Color">#FF4A88C4</Color>
    <Color x:Key="Merge.Ours.Text.Color">#FFB4D4FF</Color>
    <Color x:Key="Merge.Ours.Border.Color">#FF2B4A6E</Color>
    <SolidColorBrush x:Key="Merge.Ours.BgSubtle" Color="#554A8FE0"/>
    <SolidColorBrush x:Key="Merge.Ours.BgStrong" Color="#992B4A6E"/>
    <SolidColorBrush x:Key="Merge.Ours.Accent"   Color="#FF4A88C4"/>
    <SolidColorBrush x:Key="Merge.Ours.Text"     Color="#FFB4D4FF"/>
    <SolidColorBrush x:Key="Merge.Ours.Border"   Color="#FF2B4A6E"/>

    <!--  Theirs (green side). Same vibrancy bump as Ours: 0x1A→0x55
          alpha + brighter base hue (#1A5035 → #3DA05C) so the green
          and blue sides read as clearly distinct sections at a glance,
          rather than two near-identical near-transparent washes.  -->
    <Color x:Key="Merge.Theirs.BgSubtle.Color">#553DA05C</Color>
    <Color x:Key="Merge.Theirs.BgStrong.Color">#991A5035</Color>
    <Color x:Key="Merge.Theirs.Accent.Color">#FF3DA05C</Color>
    <Color x:Key="Merge.Theirs.Text.Color">#FFA8E6B8</Color>
    <Color x:Key="Merge.Theirs.Border.Color">#FF1A5035</Color>
    <SolidColorBrush x:Key="Merge.Theirs.BgSubtle" Color="#553DA05C"/>
    <SolidColorBrush x:Key="Merge.Theirs.BgStrong" Color="#991A5035"/>
    <SolidColorBrush x:Key="Merge.Theirs.Accent"   Color="#FF3DA05C"/>
    <SolidColorBrush x:Key="Merge.Theirs.Text"     Color="#FFA8E6B8"/>
    <SolidColorBrush x:Key="Merge.Theirs.Border"   Color="#FF1A5035"/>

    <!--  Base (neutral side)  -->
    <Color x:Key="Merge.Base.BgSubtle.Color">#12888888</Color>
    <Color x:Key="Merge.Base.BgStrong.Color">#44888888</Color>
    <Color x:Key="Merge.Base.Accent.Color">#FFB0B0B0</Color>
    <Color x:Key="Merge.Base.Text.Color">#FFC8C8C8</Color>
    <Color x:Key="Merge.Base.Border.Color">#FF4A4A4A</Color>
    <SolidColorBrush x:Key="Merge.Base.BgSubtle" Color="#12888888"/>
    <SolidColorBrush x:Key="Merge.Base.BgStrong" Color="#44888888"/>
    <SolidColorBrush x:Key="Merge.Base.Accent"   Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="Merge.Base.Text"     Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="Merge.Base.Border"   Color="#FF4A4A4A"/>

    <!--  Semantic state colors  -->
    <Color x:Key="Merge.State.Unresolved.Color">#FFE04444</Color>
    <Color x:Key="Merge.State.Resolved.Color">#FF22C55E</Color>
    <Color x:Key="Merge.State.AiPending.Color">#FF3794F2</Color>
    <Color x:Key="Merge.State.Error.Color">#FFE58A8A</Color>
    <Color x:Key="Merge.State.Warning.Color">#FFFFC107</Color>
    <Color x:Key="Merge.State.Manual.Color">#FFFFC44D</Color>
    <!--  Pre-blended Resolved overlay — the same green at ~27% alpha used as
          a tint over the already-highlighted conflict region. Lives in the
          palette so the alpha and colour can drift together with theme swaps.  -->
    <Color x:Key="Merge.State.Resolved.Overlay.Color">#4422C55E</Color>
    <SolidColorBrush x:Key="Merge.State.Unresolved" Color="#FFE04444"/>
    <SolidColorBrush x:Key="Merge.State.Resolved"   Color="#FF22C55E"/>
    <SolidColorBrush x:Key="Merge.State.AiPending"  Color="#FF3794F2"/>
    <SolidColorBrush x:Key="Merge.State.Error"      Color="#FFE58A8A"/>
    <SolidColorBrush x:Key="Merge.State.Warning"    Color="#FFFFC107"/>
    <SolidColorBrush x:Key="Merge.State.Manual"     Color="#FFFFC44D"/>
    <SolidColorBrush x:Key="Merge.State.Resolved.Overlay" Color="#4422C55E"/>

    <!--  Status-pill chrome tokens (C4). Pill background is a translucent tint
          of the state color so it reads as a contextual badge; pill text is
          the saturated state color itself for high contrast against both the
          tint and any surface depth underneath. Ship both the low-alpha Color
          (for control code that freezes its own SolidColorBrush) and the
          pre-frozen Brush (for xaml bindings).
          The three ship as a pair-per-state (Unresolved / Resolved / AiPending)
          so every state in plan §D1 has a first-class pill vocabulary — future
          AI-pending badges can bind directly without another palette round-
          trip.  -->
    <Color x:Key="Merge.State.Unresolved.PillBg.Color">#33E04444</Color>
    <Color x:Key="Merge.State.Unresolved.PillText.Color">#FFFFB2B2</Color>
    <Color x:Key="Merge.State.Resolved.PillBg.Color">#3322C55E</Color>
    <Color x:Key="Merge.State.Resolved.PillText.Color">#FF8BE0A8</Color>
    <Color x:Key="Merge.State.AiPending.PillBg.Color">#333794F2</Color>
    <Color x:Key="Merge.State.AiPending.PillText.Color">#FF8CBCE8</Color>
    <SolidColorBrush x:Key="Merge.State.Unresolved.PillBg"   Color="#33E04444"/>
    <SolidColorBrush x:Key="Merge.State.Unresolved.PillText" Color="#FFFFB2B2"/>
    <SolidColorBrush x:Key="Merge.State.Resolved.PillBg"     Color="#3322C55E"/>
    <SolidColorBrush x:Key="Merge.State.Resolved.PillText"   Color="#FF8BE0A8"/>
    <SolidColorBrush x:Key="Merge.State.AiPending.PillBg"    Color="#333794F2"/>
    <SolidColorBrush x:Key="Merge.State.AiPending.PillText"  Color="#FF8CBCE8"/>

    <!--  Surface depth layers (darker -> lighter)  -->
    <Color x:Key="Merge.Surface.1.Color">#FF181818</Color>
    <Color x:Key="Merge.Surface.2.Color">#FF1E1E1E</Color>
    <Color x:Key="Merge.Surface.3.Color">#FF252525</Color>
    <Color x:Key="Merge.Surface.4.Color">#FF2A2A2A</Color>
    <Color x:Key="Merge.Surface.5.Color">#FF2F2F2F</Color>
    <SolidColorBrush x:Key="Merge.Surface.1" Color="#FF181818"/>
    <SolidColorBrush x:Key="Merge.Surface.2" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="Merge.Surface.3" Color="#FF252525"/>
    <SolidColorBrush x:Key="Merge.Surface.4" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="Merge.Surface.5" Color="#FF2F2F2F"/>

    <!--  Borders  -->
    <Color x:Key="Merge.Border.Subtle.Color">#FF2A2A2A</Color>
    <Color x:Key="Merge.Border.Strong.Color">#FF3A3A3A</Color>
    <Color x:Key="Merge.Border.Focus.Color">#FF4A88C4</Color>
    <SolidColorBrush x:Key="Merge.Border.Subtle" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="Merge.Border.Strong" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="Merge.Border.Focus"  Color="#FF4A88C4"/>

    <!--  Image corner label scrim — 69 % alpha black drawn over image content
          so the Ours / Theirs labels stay legible regardless of pixel colour
          behind them. Intentionally pure-black in every theme because the
          scrim's job is contrast against arbitrary image content, not chrome
          styling.  -->
    <Color x:Key="Merge.Image.CornerLabelScrim.Color">#B0000000</Color>
    <SolidColorBrush x:Key="Merge.Image.CornerLabelScrim" Color="#B0000000"/>

    <!--  Drop-shadow tokens consumed by the ThemeShadow attached property.
          Shadow colour and opacity are themeable so V8 light theme can use
          black-at-higher-opacity while dark stays black-at-low-opacity.  -->
    <Color x:Key="Merge.Shadow.Color">#FF000000</Color>
    <sys:Double x:Key="Merge.Shadow.Opacity" xmlns:sys="clr-namespace:System;assembly=System.Runtime">0.15</sys:Double>

    <!--  C6 conflict-note indicator. Drawn as a filled speech-bubble glyph
          in the ReadOnlyMergePane gutter when a range carries a Note.
          Warm amber keeps it distinct from the resolved green and the
          unresolved red so the note indicator reads as "additional info",
          not a resolution state in its own right.  -->
    <Color x:Key="Merge.Note.Glyph.Color">#FFFFC44D</Color>
    <SolidColorBrush x:Key="Merge.Note.Glyph" Color="#FFFFC44D"/>

    <!--  Dialog chrome tokens consumed by the AI consent / resolution dialogs.
          The pre-V1 xaml had #11000000 / #22000000 as raw hex; moving them
          into the palette lets V8 theme swap repaint the dialog chrome along
          with everything else. "Scrim" is the dimming layer behind a modal;
          "Dialog" is the border around the dialog surface.  -->
    <Color x:Key="Merge.Surface.Scrim.Color">#11000000</Color>
    <Color x:Key="Merge.Border.Dialog.Color">#22000000</Color>
    <SolidColorBrush x:Key="Merge.Surface.Scrim" Color="#11000000"/>
    <SolidColorBrush x:Key="Merge.Border.Dialog" Color="#22000000"/>

    <!--  Text.
          Primary / Secondary / Tertiary are the three merge-chrome text
          weights consumed across the editor. OnAccent is wired on the
          Complete Merge button's foreground (reads against the accent
          fill). Disabled is reserved for any future custom surface that
          does NOT inherit the Fluent ControlTemplate's disabled state —
          inside a Fluent Button the default template already fades text
          via its own theme trigger, so the button doesn't need to bind
          to this token explicitly. Keeping the key defined (per plan
          §D1) means future custom chrome (drop-down cells, list rows)
          has a single source of truth rather than inventing its own
          disabled grey.  -->
    <Color x:Key="Merge.Text.Primary.Color">#FFE4E4E4</Color>
    <Color x:Key="Merge.Text.Secondary.Color">#FFD0D0D0</Color>
    <Color x:Key="Merge.Text.Tertiary.Color">#FF888888</Color>
    <Color x:Key="Merge.Text.Disabled.Color">#FF5A5A5A</Color>
    <Color x:Key="Merge.Text.OnAccent.Color">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Merge.Text.Primary"   Color="#FFE4E4E4"/>
    <SolidColorBrush x:Key="Merge.Text.Secondary" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="Merge.Text.Tertiary"  Color="#FF888888"/>
    <SolidColorBrush x:Key="Merge.Text.Disabled"  Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="Merge.Text.OnAccent"  Color="#FFFFFFFF"/>

</ResourceDictionary>
