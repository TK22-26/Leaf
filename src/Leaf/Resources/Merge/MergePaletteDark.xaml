<!--
    Merge editor dark-theme palette.

    Provides both the Color tokens (consumed by code that needs the raw ARGB,
    e.g. LinearGradientBrush construction) and the SolidColorBrush tokens
    (consumed by XAML). V8's MergePaletteLight.xaml is a parallel file with
    light-theme values; ThemeService swaps this dict for that one at runtime.

    Why inline Color values on each brush instead of {DynamicResource} indirection:
    cross-thread WPF DP access. Brushes with a DynamicResource-backed Color DP
    are bound to the thread they were parsed on; swapping the Dark dict for the
    Light dict cleanly updates the brushes through the lookup-by-key mechanism
    without any cross-thread hops.

    All text/background pairs verified >= WCAG AA (4.5:1) contrast against
    Merge.Surface.2 (the pane background).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Ours (blue side)  -->
    <Color x:Key="Merge.Ours.BgSubtle.Color">#1A2B4A6E</Color>
    <Color x:Key="Merge.Ours.BgStrong.Color">#992B4A6E</Color>
    <Color x:Key="Merge.Ours.Accent.Color">#FF4A88C4</Color>
    <Color x:Key="Merge.Ours.Text.Color">#FFB4D4FF</Color>
    <Color x:Key="Merge.Ours.Border.Color">#FF2B4A6E</Color>
    <SolidColorBrush x:Key="Merge.Ours.BgSubtle" Color="#1A2B4A6E"/>
    <SolidColorBrush x:Key="Merge.Ours.BgStrong" Color="#992B4A6E"/>
    <SolidColorBrush x:Key="Merge.Ours.Accent"   Color="#FF4A88C4"/>
    <SolidColorBrush x:Key="Merge.Ours.Text"     Color="#FFB4D4FF"/>
    <SolidColorBrush x:Key="Merge.Ours.Border"   Color="#FF2B4A6E"/>

    <!--  Theirs (green side)  -->
    <Color x:Key="Merge.Theirs.BgSubtle.Color">#1A1A5035</Color>
    <Color x:Key="Merge.Theirs.BgStrong.Color">#991A5035</Color>
    <Color x:Key="Merge.Theirs.Accent.Color">#FF3DA05C</Color>
    <Color x:Key="Merge.Theirs.Text.Color">#FFA8E6B8</Color>
    <Color x:Key="Merge.Theirs.Border.Color">#FF1A5035</Color>
    <SolidColorBrush x:Key="Merge.Theirs.BgSubtle" Color="#1A1A5035"/>
    <SolidColorBrush x:Key="Merge.Theirs.BgStrong" Color="#991A5035"/>
    <SolidColorBrush x:Key="Merge.Theirs.Accent"   Color="#FF3DA05C"/>
    <SolidColorBrush x:Key="Merge.Theirs.Text"     Color="#FFA8E6B8"/>
    <SolidColorBrush x:Key="Merge.Theirs.Border"   Color="#FF1A5035"/>

    <!--  Base (neutral side)  -->
    <Color x:Key="Merge.Base.BgSubtle.Color">#12888888</Color>
    <Color x:Key="Merge.Base.BgStrong.Color">#44888888</Color>
    <Color x:Key="Merge.Base.Accent.Color">#FFB0B0B0</Color>
    <Color x:Key="Merge.Base.Text.Color">#FFC8C8C8</Color>
    <Color x:Key="Merge.Base.Border.Color">#FF4A4A4A</Color>
    <SolidColorBrush x:Key="Merge.Base.BgSubtle" Color="#12888888"/>
    <SolidColorBrush x:Key="Merge.Base.BgStrong" Color="#44888888"/>
    <SolidColorBrush x:Key="Merge.Base.Accent"   Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="Merge.Base.Text"     Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="Merge.Base.Border"   Color="#FF4A4A4A"/>

    <!--  Semantic state colors  -->
    <Color x:Key="Merge.State.Unresolved.Color">#FFE04444</Color>
    <Color x:Key="Merge.State.Resolved.Color">#FF22C55E</Color>
    <Color x:Key="Merge.State.AiPending.Color">#FF3794F2</Color>
    <Color x:Key="Merge.State.Error.Color">#FFE58A8A</Color>
    <Color x:Key="Merge.State.Warning.Color">#FFFFC107</Color>
    <Color x:Key="Merge.State.Manual.Color">#FFFFC44D</Color>
    <SolidColorBrush x:Key="Merge.State.Unresolved" Color="#FFE04444"/>
    <SolidColorBrush x:Key="Merge.State.Resolved"   Color="#FF22C55E"/>
    <SolidColorBrush x:Key="Merge.State.AiPending"  Color="#FF3794F2"/>
    <SolidColorBrush x:Key="Merge.State.Error"      Color="#FFE58A8A"/>
    <SolidColorBrush x:Key="Merge.State.Warning"    Color="#FFFFC107"/>
    <SolidColorBrush x:Key="Merge.State.Manual"     Color="#FFFFC44D"/>

    <!--  Surface depth layers (darker -> lighter)  -->
    <Color x:Key="Merge.Surface.1.Color">#FF181818</Color>
    <Color x:Key="Merge.Surface.2.Color">#FF1E1E1E</Color>
    <Color x:Key="Merge.Surface.3.Color">#FF252525</Color>
    <Color x:Key="Merge.Surface.4.Color">#FF2A2A2A</Color>
    <Color x:Key="Merge.Surface.5.Color">#FF2F2F2F</Color>
    <SolidColorBrush x:Key="Merge.Surface.1" Color="#FF181818"/>
    <SolidColorBrush x:Key="Merge.Surface.2" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="Merge.Surface.3" Color="#FF252525"/>
    <SolidColorBrush x:Key="Merge.Surface.4" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="Merge.Surface.5" Color="#FF2F2F2F"/>

    <!--  Borders  -->
    <Color x:Key="Merge.Border.Subtle.Color">#FF2A2A2A</Color>
    <Color x:Key="Merge.Border.Strong.Color">#FF3A3A3A</Color>
    <Color x:Key="Merge.Border.Focus.Color">#FF4A88C4</Color>
    <SolidColorBrush x:Key="Merge.Border.Subtle" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="Merge.Border.Strong" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="Merge.Border.Focus"  Color="#FF4A88C4"/>

    <!--  Text  -->
    <Color x:Key="Merge.Text.Primary.Color">#FFE4E4E4</Color>
    <Color x:Key="Merge.Text.Secondary.Color">#FFD0D0D0</Color>
    <Color x:Key="Merge.Text.Tertiary.Color">#FF888888</Color>
    <Color x:Key="Merge.Text.Disabled.Color">#FF5A5A5A</Color>
    <Color x:Key="Merge.Text.OnAccent.Color">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Merge.Text.Primary"   Color="#FFE4E4E4"/>
    <SolidColorBrush x:Key="Merge.Text.Secondary" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="Merge.Text.Tertiary"  Color="#FF888888"/>
    <SolidColorBrush x:Key="Merge.Text.Disabled"  Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="Merge.Text.OnAccent"  Color="#FFFFFFFF"/>

</ResourceDictionary>
