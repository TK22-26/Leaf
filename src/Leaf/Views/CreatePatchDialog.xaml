<Window x:Class="Leaf.Views.CreatePatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Create Patch"
        Width="520"
        SizeToContent="Height"
        MinHeight="320"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ResizeMode="NoResize">
    <Window.Resources>
        <!--  Accent CTA button. WPF's default Button style ignores the
              Background/Foreground we set when IsEnabled flips, so a
              hardcoded Background+Foreground+IsEnabled="False" combo
              renders as full-saturation accent with white text — the
              button looks enabled but isn't. The triggers below swap
              both brushes to the Fluent disabled tokens so the visual
              state matches the actual interaction state.  -->
        <Style x:Key="AccentCtaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Create Patch File"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <!-- StackPanel children default to VerticalAlignment=Stretch
                     and measure with their own font metrics. The SemiBold
                     Consolas commit text has a different ascent than the
                     regular "Commit:" label, so without an explicit anchor
                     they don't share a baseline. Bottom on both pins the
                     descent line so they read as a single sentence. -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                    <TextBlock Text="Commit: "
                               FontSize="13"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CommitText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Consolas"
                               VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <!-- Output directory -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Output folder"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirTextBox"
                                     Grid.Column="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OutputDirTextBox_TextChanged" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Click="BrowseOutputDir_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="FolderOpen" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Browse..." />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Options"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <CheckBox x:Name="IncludeBinaryCheckBox"
                                  Margin="0,0,0,6"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <StackPanel>
                                <TextBlock Text="Include binary diffs" FontWeight="SemiBold" />
                                <TextBlock Text="Off by default; most patch-and-mail flows refuse binary deltas."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="SignOffCheckBox"
                                  Margin="0,0,0,6"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <StackPanel>
                                <TextBlock Text="Add Signed-off-by trailer" FontWeight="SemiBold" />
                                <TextBlock Text="Required by some upstreams (Linux kernel, etc.)."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Subject prefix (optional)" FontWeight="SemiBold" />
                            <TextBlock Text="Defaults to git's standard 'PATCH' prefix when blank."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="SubjectPrefixTextBox" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Padding="20,10"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="CreateButton"
                        Margin="12,0,0,0"
                        Padding="24,10"
                        Click="Create_Click"
                        IsEnabled="False"
                        Style="{StaticResource AccentCtaButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="Save" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Create" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
