<Window x:Class="Leaf.Views.RebaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Leaf.ViewModels"
        xmlns:models="clr-namespace:Leaf.Models"
        xmlns:converters="clr-namespace:Leaf.Converters"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        d:DataContext="{d:DesignInstance Type=viewmodels:RebaseDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Height="500"
        Width="500"
        MinHeight="460"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:EnumBooleanConverter x:Key="EnumBooleanConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Branch Info -->
        <Border Grid.Row="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Replaying branch (HEAD) -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Rebase:"
                           FontWeight="SemiBold"
                           Margin="0,0,8,4"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="BranchFork" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SourceBranch}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text=" (current)"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Target -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Onto:"
                           FontWeight="SemiBold"
                           Margin="0,4,8,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <ic:SymbolIcon Symbol="BranchFork" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TargetBranch}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Rebase mode"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <RadioButton Content="Standard"
                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static models:RebaseMode.Standard}}"
                         Margin="0,0,0,4"/>
            <TextBlock Text="Replay commits onto the target branch with no plan editor."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="11"
                       Margin="20,0,0,8"/>

            <RadioButton Content="Interactive"
                         IsChecked="{Binding SelectedMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static models:RebaseMode.Interactive}}"
                         Margin="0,0,0,4"/>
            <TextBlock Text="Open the plan editor — pick, squash, reword, or drop each commit before replay."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="11"
                       Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="Options"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <CheckBox Content="Autosquash"
                      IsChecked="{Binding Autosquash}"
                      Margin="0,0,0,4"/>
            <TextBlock Text="Apply fixup! / squash! commits automatically (--autosquash)."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="11"
                       Margin="20,0,0,8"/>

            <CheckBox Content="Update dependent refs"
                      IsChecked="{Binding UpdateRefs}"
                      Margin="0,0,0,4"/>
            <TextBlock Text="Move every branch that pointed at a rewritten commit to its new position (--update-refs)."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="11"
                       Margin="20,0,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Spacer -->
        <Grid Grid.Row="4"/>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Padding="16,8"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button x:Name="RebaseButton"
                    Content="{Binding RebaseButtonText}"
                    Padding="16,8"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsEnabled="{Binding CanRebase}"
                    Click="Rebase_Click"/>
        </StackPanel>
    </Grid>
</Window>
