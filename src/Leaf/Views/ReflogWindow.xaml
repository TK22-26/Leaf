<Window x:Class="Leaf.Views.ReflogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Leaf.ViewModels"
        xmlns:models="clr-namespace:Leaf.Models"
        xmlns:converters="clr-namespace:Leaf.Converters"
        Title="Reflog"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ref" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="180"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding RefOptions}"
                          SelectedItem="{Binding SelectedRef}"/>

                <TextBlock Text="Operation" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="130"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding OperationTypeOptions}"
                          SelectedItem="{Binding SelectedOperationType}"/>

                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker Width="120"
                            Margin="0,0,8,0"
                            SelectedDate="{Binding StartDate}"/>

                <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker Width="120"
                            Margin="0,0,12,0"
                            SelectedDate="{Binding EndDate}"/>

                <Button Command="{Binding ClearFiltersCommand}" Padding="8,2">Clear</Button>
            </StackPanel>

            <TextBox Grid.Column="1"
                     Margin="12,0"
                     VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="Search SHA, ref, or message (case-insensitive)"/>

            <Button Grid.Column="2"
                    Command="{Binding LoadCommand}"
                    Padding="10,2"
                    ToolTip="Re-read reflog from git">
                Refresh
            </Button>
        </Grid>

        <!-- Error banner -->
        <Border Grid.Row="1"
                Padding="8,4"
                Margin="0,0,0,8"
                Background="#33DC2626"
                CornerRadius="3"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Entries grid -->
        <DataGrid Grid.Row="2"
                  x:Name="EntriesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Checkout (detached HEAD)"
                              Command="{Binding CheckoutCommand}"/>
                    <MenuItem Header="Reset current branch to here">
                        <MenuItem Header="Soft (keep index + working tree)"
                                  Command="{Binding ResetSoftCommand}"/>
                        <MenuItem Header="Mixed (keep working tree, reset index)"
                                  Command="{Binding ResetMixedCommand}"/>
                        <MenuItem Header="Hard (discard index + working tree)"
                                  Command="{Binding ResetHardCommand}"
                                  Foreground="#DC2626"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Create branch here..."
                              Command="{Binding CreateBranchHereCommand}"/>
                    <MenuItem Header="Copy hash"
                              Command="{Binding CopyHashCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp"
                                    Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                    Width="Auto"
                                    IsReadOnly="True"
                                    SortDirection="Descending"/>
                <DataGridTextColumn Header="Ref"
                                    Binding="{Binding Ref}"
                                    Width="Auto"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Operation"
                                    Binding="{Binding OperationType}"
                                    Width="Auto"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="SHA"
                                    Binding="{Binding ShortSha}"
                                    Width="Auto"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"/>
                <DataGridTextColumn Header="Message"
                                    Binding="{Binding Message}"
                                    Width="*"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer status -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusSummary}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <Button Grid.Column="1"
                    Padding="12,4"
                    IsCancel="True"
                    Click="CloseButton_Click">
                Close
            </Button>
        </Grid>
    </Grid>
</Window>
