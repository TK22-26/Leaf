<Window x:Class="Leaf.Views.StartBisectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Start Bisect"
        Width="520"
        SizeToContent="Height"
        MinHeight="320"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ResizeMode="NoResize">
    <Window.Resources>
        <!--  Accent CTA button — keeps the disabled state visually
              distinct (see CreatePatchDialog for the rationale).  -->
        <Style x:Key="AccentCtaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Find Regression with Bisect"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Mark one commit you know is bad and one you know is good. Git will check out a midpoint commit; you test it and click Good or Bad until the regression is pinned to a single commit."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,16" />

                <!-- Bad commit -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="Bad commit " />
                            <Run Text="(regression is present)"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="A SHA, branch name, or tag where the bug exists. Defaults to HEAD."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,8" />
                        <TextBox x:Name="BadRefTextBox"
                                 FontFamily="Consolas"
                                 Padding="10,8"
                                 TextChanged="Ref_TextChanged" />
                    </StackPanel>
                </Border>

                <!-- Good commit -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="Good commit " />
                            <Run Text="(regression is NOT present)"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="A SHA, branch name, or tag where the code worked. Must be an ancestor of the bad commit."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,8" />
                        <TextBox x:Name="GoodRefTextBox"
                                 FontFamily="Consolas"
                                 Padding="10,8"
                                 TextChanged="Ref_TextChanged" />
                    </StackPanel>
                </Border>

                <!-- Hint -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ic:SymbolIcon Symbol="Info"
                                       FontSize="16"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Bisect checks out commits as it works — uncommitted changes will block this. Stash or commit first if needed." />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Padding="20,10"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="StartButton"
                        Margin="12,0,0,0"
                        Padding="24,10"
                        Click="Start_Click"
                        IsEnabled="False"
                        Style="{StaticResource AccentCtaButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="Search" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Start Bisect" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
