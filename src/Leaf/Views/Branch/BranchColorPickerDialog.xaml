<Window x:Class="Leaf.Views.Branch.BranchColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Leaf.Converters"
        Title="Branch colour"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="Segoe UI Variable">
    <Window.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="HeaderTextBlock"
                   Text="Choose colour for branch"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Preview swatch + label -->
        <Border Grid.Row="1"
                Height="44"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Margin="0,0,0,12">
            <Border.Background>
                <SolidColorBrush x:Name="PreviewBrush" Color="#3B82F6"/>
            </Border.Background>
            <TextBlock x:Name="PreviewLabel"
                       Text="branch-name"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <!-- HSV sliders -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hue"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Slider x:Name="HueSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="360"
                    Value="220"
                    SmallChange="1"
                    LargeChange="10"
                    TickFrequency="60"
                    IsSnapToTickEnabled="False"
                    ValueChanged="HsvSlider_ValueChanged"/>
            <TextBlock x:Name="HueValueLabel"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="220"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Sat"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Slider x:Name="SaturationSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Value="80"
                    SmallChange="1"
                    LargeChange="10"
                    ValueChanged="HsvSlider_ValueChanged"/>
            <TextBlock x:Name="SaturationValueLabel"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="80"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Val"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Slider x:Name="ValueSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Value="96"
                    SmallChange="1"
                    LargeChange="10"
                    ValueChanged="HsvSlider_ValueChanged"/>
            <TextBlock x:Name="ValueValueLabel"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="96"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- Hex input -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hex"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBox x:Name="HexTextBox"
                     Grid.Column="1"
                     FontFamily="Consolas, Cascadia Mono, Lucida Console"
                     MaxLength="9"
                     Text="#3B82F6"
                     LostFocus="HexTextBox_LostFocus"
                     KeyDown="HexTextBox_KeyDown"/>
        </Grid>

        <!-- Palette swatches -->
        <TextBlock Grid.Row="6"
                   Text="Palette"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,6"/>
        <ItemsControl x:Name="PaletteItems"
                      Grid.Row="6"
                      Margin="0,20,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="28"
                            Height="28"
                            Margin="0,0,4,4"
                            Padding="0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Click="PaletteSwatch_Click"
                            ToolTip="{Binding Hex}"
                            Tag="{Binding Color}"
                            Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Buttons -->
        <Grid Grid.Row="7" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="UseAutoButton"
                    Content="Use Auto"
                    ToolTip="Remove the override and let the palette decide this branch's colour"
                    Padding="12,4"
                    Click="UseAutoButton_Click"/>
            <!-- Declaration order matches visual order (OK left of
                 Cancel) so keyboard Tab traversal follows the layout. -->
            <Button Grid.Column="2"
                    x:Name="OkButton"
                    Content="OK"
                    Width="80"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Grid.Column="3"
                    Content="Cancel"
                    Width="80"
                    Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
