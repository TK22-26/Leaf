<UserControl x:Class="Leaf.Views.BisectBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:converters="clr-namespace:Leaf.Converters">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
    </UserControl.Resources>

    <!--  Mustard strip above the commit graph. Slim by design — verdict
          buttons + diff + log live in the right pane (BisectDetailView)
          where the user has more room and the diff anchors the decision.
          Here we keep just: mode indicator, current commit summary,
          steps-remaining hint, and End Bisect (always reachable
          regardless of what's focused on the right).  -->
    <Border Background="#3D2E0A"
            BorderBrush="#7A5C14"
            BorderThickness="0,0,0,1"
            Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <ic:SymbolIcon Symbol="Search"
                               FontSize="14"
                               Foreground="#F5C842"
                               Margin="0,0,8,0" />
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#F5E0A0"
                           Text="Bisecting" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!--  Testing mode  -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding BisectFoundSha, Converter={StaticResource NullToVisibilityInverseConverter}}">
                    <TextBlock Foreground="#E8DCC0" Text="Testing " />
                    <TextBlock FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Foreground="#F5E0A0"
                               Text="{Binding CurrentBisectState.CurrentShortSha}" />
                    <TextBlock Foreground="#A89868"
                               Margin="12,0,0,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding CurrentBisectState.StepsRemaining, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="~" /><Run Text="{Binding CurrentBisectState.StepsRemaining, Mode=OneWay, FallbackValue=''}" /><Run Text=" steps remaining" />
                    </TextBlock>
                </StackPanel>

                <!--  Converged mode  -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding BisectFoundSha, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Foreground="#E8DCC0" Text="First bad commit: " />
                    <TextBlock FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Foreground="#F5C842"
                               Text="{Binding BisectFoundSha}" />
                </StackPanel>
            </StackPanel>

            <!--  Always-available exit. Verdict buttons (Good/Bad/Skip)
                  and the verdict log + Undo all live in the right pane;
                  this strip stays clean to avoid duplicate affordances.  -->
            <Button Grid.Column="2"
                    Padding="12,4"
                    Background="Transparent"
                    BorderBrush="#7A5C14"
                    BorderThickness="1"
                    Foreground="#F5E0A0"
                    Command="{Binding ResetBisectCommand}"
                    ToolTip="End bisect and restore HEAD (git bisect reset)">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon Symbol="ArrowReset" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="End Bisect" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
