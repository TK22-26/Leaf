<UserControl x:Class="Leaf.Views.BisectBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:converters="clr-namespace:Leaf.Converters">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
    </UserControl.Resources>

    <!-- Mustard-yellow strip with current commit + verdict buttons. The
         banner sits between the action bar and the commit graph; it is
         a hard signal that "you're in a special mode" without taking
         over a pane. -->
    <Border Background="#3D2E0A"
            BorderBrush="#7A5C14"
            BorderThickness="0,0,0,1"
            Padding="16,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status icon + label -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <ic:SymbolIcon Symbol="Search"
                               FontSize="16"
                               Foreground="#F5C842"
                               Margin="0,0,8,0" />
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#F5E0A0">
                    <Run Text="Bisecting" />
                </TextBlock>
            </StackPanel>

            <!-- Current state info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- Mid-bisect: testing mode -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding BisectFoundSha, Converter={StaticResource NullToVisibilityInverseConverter}}">
                    <TextBlock Foreground="#E8DCC0" Text="Testing " />
                    <TextBlock FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Foreground="#F5E0A0"
                               Text="{Binding CurrentBisectState.CurrentShortSha}" />
                    <TextBlock Foreground="#E8DCC0" Text=" — " />
                    <TextBlock Foreground="#E8DCC0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               Text="{Binding CurrentBisectState.CurrentSubject}" />
                    <!-- Parenthetical is bound to a nullable int? — when
                         git's "Bisecting:" line didn't carry a "(roughly K
                         steps)" hint (first step, cold open, untranslated
                         locale), we hide the whole text rather than show a
                         misleading "(0 steps left)". -->
                    <TextBlock Foreground="#A89868"
                               Margin="12,0,0,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding CurrentBisectState.StepsRemaining, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="(" /><Run Text="{Binding CurrentBisectState.StepsRemaining, Mode=OneWay, FallbackValue=''}" /><Run Text=" steps left)" />
                    </TextBlock>
                </StackPanel>

                <!-- Converged: found the bad commit -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding BisectFoundSha, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Foreground="#E8DCC0" Text="First bad commit: " />
                    <TextBlock FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Foreground="#F5C842"
                               Text="{Binding BisectFoundSha}" />
                </StackPanel>
            </StackPanel>

            <!-- Verdict buttons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- Mid-bisect verdict buttons (hidden after convergence) -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding BisectFoundSha, Converter={StaticResource NullToVisibilityInverseConverter}}">
                    <Button Padding="12,6"
                            Margin="0,0,6,0"
                            Background="#1E3A1E"
                            Foreground="#9FE89F"
                            Command="{Binding MarkBisectGoodCommand}"
                            ToolTip="Regression NOT present in this commit (git bisect good)">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Good" />
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6"
                            Margin="0,0,6,0"
                            Background="#3A1E1E"
                            Foreground="#E89F9F"
                            Command="{Binding MarkBisectBadCommand}"
                            ToolTip="Regression IS present in this commit (git bisect bad)">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Bad" />
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6"
                            Margin="0,0,12,0"
                            Background="#2A2A3A"
                            Foreground="#C0C0E0"
                            Command="{Binding MarkBisectSkipCommand}"
                            ToolTip="Cannot test this commit — let git pick another (git bisect skip)">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowForward" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Skip" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Reset (always visible during bisect) -->
                <Button Padding="12,6"
                        Background="Transparent"
                        BorderBrush="#7A5C14"
                        BorderThickness="1"
                        Foreground="#F5E0A0"
                        Command="{Binding ResetBisectCommand}"
                        ToolTip="End bisect and restore HEAD (git bisect reset)">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="ArrowReset" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="End Bisect" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
