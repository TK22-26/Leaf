<Window x:Class="Leaf.Views.Merge.MergeEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:merge="clr-namespace:Leaf.Controls.Merge"
        xmlns:textedit="clr-namespace:Leaf.TextEdit"
        xmlns:views="clr-namespace:Leaf.Views"
        mc:Ignorable="d"
        Title="Resolve Conflicts — Leaf"
        Height="720" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        AutomationProperties.AutomationId="MergeEditorView">
    <Window.InputBindings>
        <!-- Keyboard shortcuts for the merge editor. The Alt+1 / Alt+2 / Alt+3
             pattern matches VS Code's merge editor; F8 / Shift+F8 matches the
             build-error navigation many power users already know. -->
        <KeyBinding Modifiers="Alt" Key="D1" Command="{Binding AcceptCurrentConflictOursCommand}"/>
        <KeyBinding Modifiers="Alt" Key="D2" Command="{Binding AcceptCurrentConflictTheirsCommand}"/>
        <KeyBinding Modifiers="Alt" Key="D3" Command="{Binding AcceptCurrentConflictBothCommand}"/>
        <KeyBinding Key="F8" Command="{Binding NextConflictCommand}"/>
        <KeyBinding Modifiers="Shift" Key="F8" Command="{Binding PreviousConflictCommand}"/>
        <!-- C2 WinMerge-style intra-conflict navigation. Alt+Left/Right steps
             through change spans inside the current conflict; Alt+Up/Down
             steps through non-conflicting auto-merged regions. -->
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding NextChangeSpanCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding PreviousChangeSpanCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Down" Command="{Binding NextAutoMergedRegionCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding PreviousAutoMergedRegionCommand}"/>
        <!-- C3: Ctrl+K opens a merge-scoped command palette listing every
             VM command with its keybinding. Reuses the existing
             CommandPaletteView from the main window. -->
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding MarkResolvedCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding RedoCommand}"/>
        <!-- Alt+A — Ask the AI for a resolution for the current conflict. Only
             does anything if the AI merge feature is enabled in settings and
             an MCP server is configured; otherwise the command is a silent no-op. -->
        <KeyBinding Modifiers="Alt" Key="A" Command="{Binding RequestAiResolutionCommand}"/>
    </Window.InputBindings>
    <Grid Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header: source → target branches -->
            <RowDefinition Height="*"/>      <!-- Main content -->
            <RowDefinition Height="Auto"/>   <!-- Footer: commit buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FileListColumn" Width="280"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header card. Same Merge.PaneCard style as the content panes so the
             whole editor reads as a coherent stack of cards. 8 px outer margin
             lets the rounded corners clear the window chrome. -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource Merge.PaneCard}"
                Margin="8,8,8,4"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Merging " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SourceBranch}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text=" → " FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                <TextBlock Text="{Binding TargetBranch}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ResolvedFiles, StringFormat='{}{0} / '}" FontSize="13"/>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding TotalFiles, StringFormat='{}{0} files resolved'}" FontSize="13"/>

                <!-- Conflict-state pills — V3 extracts StatusPill UserControl
                     so the merge status sidebar can reuse the same visual. Dots
                     pull their Fill from the Merge.State.* palette so V8 theme
                     swap repaints automatically. AI-pending pill hides at zero
                     until C6 plugs persistent per-range AI state into the
                     count. -->
                <merge:StatusPill Margin="24,0,0,0"
                                  Label="Unresolved"
                                  Count="{Binding UnresolvedConflictCount}"
                                  DotBrush="{DynamicResource Merge.State.Unresolved}"
                                  AutomationProperties.AutomationId="Merge.UnresolvedPill"/>
                <merge:StatusPill Margin="16,0,0,0"
                                  Label="Resolved"
                                  Count="{Binding ResolvedConflictCount}"
                                  DotBrush="{DynamicResource Merge.State.Resolved}"
                                  AutomationProperties.AutomationId="Merge.ResolvedPill"/>
                <merge:StatusPill Margin="16,0,0,0"
                                  Label="AI-pending"
                                  Count="{Binding AiPendingConflictCount}"
                                  DotBrush="{DynamicResource Merge.State.AiPending}"
                                  Visibility="{Binding IsAiRequestInFlight, Converter={StaticResource BoolToVisibilityConverter}}"
                                  AutomationProperties.AutomationId="Merge.AiPendingPill"/>
            </StackPanel>
        </Border>

        <!-- File list card. PaneCard style brings the 1 px hairline + subtle
             shadow; 8 px outer margin gives the corner radius room to breathe. -->
        <Border Grid.Row="1" Grid.Column="0"
                Style="{StaticResource Merge.PaneCard}"
                Margin="8,4,4,4">
            <ListBox AutomationProperties.AutomationId="Merge.ConflictFileList"
                     ItemsSource="{Binding Conflicts}"
                     SelectedItem="{Binding SelectedConflict}"
                     DisplayMemberPath="FilePath"
                     BorderThickness="0"
                     Background="Transparent"/>
        </Border>

        <!-- C1 vertical splitter between the file list and the panes area.
             Width matches the splitter column so the drag gutter fills it. -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      AutomationProperties.AutomationId="Merge.FileListSplitter"/>

        <!-- Main pane area. Top row holds the two input panes separated by
             a dedicated middle column for the connection canvas so the
             bezier curves don't overlap pane content or minimaps. Bottom
             row is the single result pane spanning all three columns. -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PanesRow" Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition x:Name="ResultRow" Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OursColumn" Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition x:Name="TheirsColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- C1 vertical splitter between Ours and the Canvas/Theirs group -->
            <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.AutomationId="Merge.OursTheirsSplitter"/>

            <!-- C1 horizontal splitter between the panes row and the Result row -->
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          AutomationProperties.AutomationId="Merge.ResultRowSplitter"/>

            <!-- Ours pane card -->
            <Border Grid.Row="0" Grid.Column="0"
                    x:Name="OursCard"
                    Style="{StaticResource Merge.PaneCard}"
                    Margin="4,4,2,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,6"
                        Background="{DynamicResource Merge.Surface.3}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Merge.Border.Subtle}">
                    <TextBlock Text="OURS" FontWeight="SemiBold"
                               FontSize="{DynamicResource Merge.Type.CaptionStrong.Size}"
                               Foreground="{DynamicResource Merge.Ours.Text}"/>
                </Border>
                <merge:StickyConflictHeader Grid.Row="1"
                                            x:Name="OursSticky"
                                            AutomationProperties.AutomationId="Merge.OursSticky"
                                            Side="Ours"
                                            Ranges="{Binding Document.Ranges}"
                                            RangeStates="{Binding RangeStates}"
                                            Layout="{Binding Layout}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" x:Name="OursScrollViewer"
                                  Background="{DynamicResource Merge.Surface.2}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  ScrollChanged="OnOursScrollChanged">
                        <merge:ReadOnlyMergePane x:Name="OursPane"
                                                 AutomationProperties.AutomationId="Merge.OursPane"
                                                 Side="Ours"
                                                 Lines="{Binding OursLines}"
                                                 Regions="{Binding Document.Ranges}"
                                                 RangeStates="{Binding RangeStates}"
                                                 WordDiffs="{Binding OursWordDiffs}"
                                                 Layout="{Binding Layout}"
                                                 Foreground="{DynamicResource Merge.Text.Primary}"
                                                 HighlightBrush="{DynamicResource Merge.Ours.BgSubtle}"
                                                 FilePath="{Binding SelectedConflict.FilePath}"
                                                 />
                    </ScrollViewer>
                    <merge:ConflictMinimap Grid.Column="1"
                                           x:Name="OursMinimap"
                                           AutomationProperties.AutomationId="Merge.OursMinimap"
                                           Side="Ours"
                                           LineCount="{Binding OursLines.Count, FallbackValue=0}"
                                           Regions="{Binding Document.Ranges}"
                                           RangeStates="{Binding RangeStates}"
                                           Layout="{Binding Layout}"
                                           JumpRequested="OnOursMinimapJump"/>
                </Grid>
            </Grid>
            </Border>

            <!-- Connection-canvas card. Wrapped in the same Merge.PaneCard
                 style as the Ours / Theirs / Result panes so the whole editor
                 reads as a unified card grid. Bezier endpoints in
                 PaneConnectionCanvas are inset by CardCornerInset (6 px, the
                 PaneCard CornerRadius) so curves stay inside the rounded
                 clip region — no corner-shaving artifacts even for conflicts
                 at the very top or bottom of the canvas. -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource Merge.PaneCard}"
                    Margin="2,4,2,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Row 0 is a fixed-height spacer so the canvas content below
                     starts at the same Y as the Ours / Theirs pane content
                     (whose cards put a CaptionStrong title bar in their Row 0
                     at ~30 px). Keeping the spacer explicit prevents the
                     curves from visually drifting above or below the first
                     content line when the title bar typography changes. -->
                <merge:PaneConnectionCanvas Grid.Row="1"
                                            x:Name="ConnectionCanvas"
                                            AutomationProperties.AutomationId="Merge.ConnectionCanvas"
                                            Layout="{Binding Layout}"
                                            Regions="{Binding Document.Ranges}"
                                            RangeStates="{Binding RangeStates}"/>
            </Grid>
            </Border>

            <!-- Theirs pane card -->
            <Border Grid.Row="0" Grid.Column="3"
                    x:Name="TheirsCard"
                    Style="{StaticResource Merge.PaneCard}"
                    Margin="2,4,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,6"
                        Background="{DynamicResource Merge.Surface.3}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Merge.Border.Subtle}">
                    <TextBlock Text="THEIRS" FontWeight="SemiBold"
                               FontSize="{DynamicResource Merge.Type.CaptionStrong.Size}"
                               Foreground="{DynamicResource Merge.Theirs.Text}"/>
                </Border>
                <merge:StickyConflictHeader Grid.Row="1"
                                            x:Name="TheirsSticky"
                                            AutomationProperties.AutomationId="Merge.TheirsSticky"
                                            Side="Theirs"
                                            Ranges="{Binding Document.Ranges}"
                                            RangeStates="{Binding RangeStates}"
                                            Layout="{Binding Layout}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" x:Name="TheirsScrollViewer"
                                  Background="{DynamicResource Merge.Surface.2}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  ScrollChanged="OnTheirsScrollChanged">
                        <merge:ReadOnlyMergePane x:Name="TheirsPane"
                                                 AutomationProperties.AutomationId="Merge.TheirsPane"
                                                 Side="Theirs"
                                                 Lines="{Binding TheirsLines}"
                                                 Regions="{Binding Document.Ranges}"
                                                 RangeStates="{Binding RangeStates}"
                                                 WordDiffs="{Binding TheirsWordDiffs}"
                                                 Layout="{Binding Layout}"
                                                 Foreground="{DynamicResource Merge.Text.Primary}"
                                                 HighlightBrush="{DynamicResource Merge.Theirs.BgSubtle}"
                                                 FilePath="{Binding SelectedConflict.FilePath}"
                                                 />
                    </ScrollViewer>
                    <merge:ConflictMinimap Grid.Column="1"
                                           x:Name="TheirsMinimap"
                                           AutomationProperties.AutomationId="Merge.TheirsMinimap"
                                           Side="Theirs"
                                           LineCount="{Binding TheirsLines.Count, FallbackValue=0}"
                                           Regions="{Binding Document.Ranges}"
                                           RangeStates="{Binding RangeStates}"
                                           Layout="{Binding Layout}"
                                           JumpRequested="OnTheirsMinimapJump"/>
                </Grid>
            </Grid>
            </Border>

            <!-- Result pane card -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                    x:Name="ResultCard"
                    Style="{StaticResource Merge.PaneCard}"
                    Margin="4,2,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,6"
                            Background="{DynamicResource Merge.Surface.3}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Merge.Border.Subtle}">
                        <TextBlock Text="RESULT" FontWeight="SemiBold"
                                   FontSize="{DynamicResource Merge.Type.CaptionStrong.Size}"
                                   Foreground="{DynamicResource Merge.Text.Primary}"/>
                    </Border>
                    <!-- Result pane with two overlays. CodeLens sits above
                         each conflict's first line with link-button choices;
                         the SegmentedAcceptPill overlay right-aligns a 3-cell
                         pill per conflict into the result pane's scrollbar
                         gutter. Both overlays bind VerticalOffset to
                         ResultPane.VerticalOffset so they track scrolling. -->
                    <merge:StickyConflictHeader Grid.Row="1"
                                                x:Name="ResultSticky"
                                                AutomationProperties.AutomationId="Merge.ResultSticky"
                                                Side="Result"
                                                Ranges="{Binding Document.Ranges}"
                                                RangeStates="{Binding RangeStates}"
                                                Layout="{Binding Layout}"
                                                VerticalOffset="{Binding ElementName=ResultPaneInstance, Path=VerticalOffset}"/>
                    <Grid Grid.Row="2">
                        <merge:ResultPane x:Name="ResultPaneInstance"
                                          AutomationProperties.AutomationId="Merge.ResultPane"
                                          Text="{Binding ComposedText, Mode=OneWay}"
                                          Layout="{Binding Layout}"
                                          FilePath="{Binding SelectedConflict.FilePath}"
                                          ResultTextChanged="OnResultTextChanged"/>
                        <merge:CodeLensActionBar AutomationProperties.AutomationId="Merge.CodeLens"
                                                 Ranges="{Binding Document.Ranges}"
                                                 RangeStates="{Binding RangeStates}"
                                                 Layout="{Binding Layout}"
                                                 VerticalOffset="{Binding ElementName=ResultPaneInstance, Path=VerticalOffset}"
                                                 AcceptOursCommand="{Binding AcceptOursCommand}"
                                                 AcceptTheirsCommand="{Binding AcceptTheirsCommand}"
                                                 AcceptBothCommand="{Binding AcceptBothCommand}"
                                                 CompareCommand="{Binding CompareConflictCommand}"/>
                        <merge:SegmentedAcceptPillOverlay x:Name="SegmentedPills"
                            AutomationProperties.AutomationId="Merge.SegmentedPills"
                            Ranges="{Binding Document.Ranges}"
                            RangeStates="{Binding RangeStates}"
                            Layout="{Binding Layout}"
                            VerticalOffset="{Binding ElementName=ResultPaneInstance, Path=VerticalOffset}"
                            AcceptOursCommand="{Binding AcceptOursCommand}"
                            AcceptTheirsCommand="{Binding AcceptTheirsCommand}"
                            AcceptBothCommand="{Binding AcceptBothCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Engine-error overlay -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="3"
                    Visibility="{Binding IsEngineError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                    <ic:SymbolIcon Symbol="ErrorCircle" FontSize="48"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="Merge engine could not process this file"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock Text="{Binding EngineErrorMessage}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Padding="16,8" Margin="0,0,8,0" Command="{Binding UseOursCommand}">
                            <TextBlock Text="Use Ours"/>
                        </Button>
                        <Button Padding="16,8" Command="{Binding UseTheirsCommand}">
                            <TextBlock Text="Use Theirs"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Binary-file overlay — Phase 6 replaces the pre-Phase-6 "choose a
                 version" stack with an ImageConflictPane when the bytes decode
                 as a recognised image format. The pane handles all five modes
                 internally (SideBySide / OnionSkin / Swipe / Difference /
                 Overlay). Use Ours / Use Theirs remain on the footer, usable
                 from either the image pane or the text-merge flow. -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="3"
                  Visibility="{Binding IsBinaryConflict, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Mode picker + swipe/onion-skin sliders -->
                <Border Grid.Row="0"
                        Padding="12,8"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox MinWidth="160"
                                  SelectedValue="{Binding ImageViewport.Mode, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Tag="{x:Static merge:ImageMergeMode.SideBySide}" Content="Side by side"/>
                            <ComboBoxItem Tag="{x:Static merge:ImageMergeMode.OnionSkin}" Content="Onion skin"/>
                            <ComboBoxItem Tag="{x:Static merge:ImageMergeMode.Swipe}" Content="Swipe"/>
                            <ComboBoxItem Tag="{x:Static merge:ImageMergeMode.Difference}" Content="Difference"/>
                            <ComboBoxItem Tag="{x:Static merge:ImageMergeMode.Overlay}" Content="Overlay"/>
                        </ComboBox>
                        <TextBlock Text="Swipe:" VerticalAlignment="Center" Margin="24,0,6,0"/>
                        <Slider Width="120"
                                Minimum="0" Maximum="1" TickFrequency="0.01"
                                Value="{Binding ImageViewport.SwipeRatio, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Onion:" VerticalAlignment="Center" Margin="24,0,6,0"/>
                        <Slider Width="120"
                                Minimum="0" Maximum="1" TickFrequency="0.01"
                                Value="{Binding ImageViewport.OnionSkinOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <Button Margin="24,0,0,0" Padding="10,4"
                                Click="OnResetImageView_Click"
                                ToolTip="Reset zoom and pan"
                                Content="Reset View"/>
                    </StackPanel>
                </Border>

                <merge:ImageConflictPane Grid.Row="1"
                                         Payload="{Binding ImagePayload}"
                                         Viewport="{Binding ImageViewport}"/>
            </Grid>
        </Grid>

        <!-- Footer card. Same Merge.PaneCard style as the header so the editor
             reads as a coherent top-header / content / bottom-footer stack.
             V3 groups the buttons into three clusters:
               - Left:   history (Undo / Redo) — pinned to the left edge.
               - Middle: batch-accept (All Ours / All Theirs / Ask AI) — sits
                         in the flexible column with a 32 px min gap to both
                         neighbours; extra width goes between left and middle.
               - Right:  finalise (Mark Resolved / Complete Merge / Abort) —
                         pinned to the right edge.
             Each button gets a 16 px FluentIcon prefix so the action is
             scannable without reading the label. -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource Merge.PaneCard}"
                Margin="8,4,8,8"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left cluster: history -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.UndoButton">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowUndo" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Undo" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RedoCommand}" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.RedoButton">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowRedo" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Redo" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Middle cluster: batch accept + AI. Right-aligned within the
                     middle column so the gap to the finalise cluster is fixed
                     at 32 px regardless of window width. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="32,0,32,0">
                    <!-- ArrowLeft/ArrowRight on the batch-accept buttons: the
                         glyphs match the pane layout (Ours on the left, Theirs
                         on the right) so users scanning the footer can tell
                         the three "accept" actions apart by icon alone. -->
                    <Button Command="{Binding AcceptAllOursCommand}" Margin="0,0,8,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.AcceptAllOurs">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowLeft" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Accept All Ours" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AcceptAllTheirsCommand}" Margin="0,0,8,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.AcceptAllTheirs">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="ArrowRight" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Accept All Theirs" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Ask AI — requests a proposed resolution for the current
                         conflict via the configured MCP server. Hidden when the
                         feature isn't available (no assistant injected) so it
                         doesn't dangle in UIs that don't use AI. -->
                    <Button Command="{Binding RequestAiResolutionCommand}"
                            Visibility="{Binding CanRequestAiResolution, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsEnabled="{Binding CanRequestAiResolution}"
                            Padding="12,6"
                            AutomationProperties.AutomationId="Merge.AskAi"
                            ToolTip="Ask AI to propose a resolution for the current conflict (Alt+A)">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Sparkle" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Ask AI" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right cluster: finalise -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding MarkResolvedCommand}" Margin="0,0,8,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.MarkResolved">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Mark Resolved" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CompleteMergeCommand}" Padding="12,6"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            AutomationProperties.AutomationId="Merge.CompleteMerge">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Complete Merge" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AbortMergeCommand}" Margin="8,0,0,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.AbortMerge">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Abort" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- C3 command palette overlay. DataContext scoped to Palette so the
             existing CommandPaletteView binding shape (SearchText, FilteredResults,
             SelectedResult, IsOpen, etc.) resolves against the merge-specific VM.
             RowSpan + ZIndex put it above all three outer rows; Visibility
             collapses it when IsOpen is false so the backdrop doesn't block
             clicks on the closed state. -->
        <views:CommandPaletteView
            Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
            Panel.ZIndex="100"
            DataContext="{Binding Palette}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.AutomationId="Merge.CommandPalette"/>
    </Grid>
</Window>
