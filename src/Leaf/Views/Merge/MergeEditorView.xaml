<Window x:Class="Leaf.Views.Merge.MergeEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:merge="clr-namespace:Leaf.Controls.Merge"
        xmlns:textedit="clr-namespace:Leaf.TextEdit"
        mc:Ignorable="d"
        Title="Resolve Conflicts — Leaf"
        Height="720" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        AutomationProperties.AutomationId="MergeEditorView">
    <Window.InputBindings>
        <!-- Keyboard shortcuts for the merge editor. The Alt+1 / Alt+2 / Alt+3
             pattern matches VS Code's merge editor; F8 / Shift+F8 matches the
             build-error navigation many power users already know. -->
        <KeyBinding Modifiers="Alt" Key="D1" Command="{Binding AcceptCurrentConflictOursCommand}"/>
        <KeyBinding Modifiers="Alt" Key="D2" Command="{Binding AcceptCurrentConflictTheirsCommand}"/>
        <KeyBinding Modifiers="Alt" Key="D3" Command="{Binding AcceptCurrentConflictBothCommand}"/>
        <KeyBinding Key="F8" Command="{Binding NextConflictCommand}"/>
        <KeyBinding Modifiers="Shift" Key="F8" Command="{Binding PreviousConflictCommand}"/>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding MarkResolvedCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- Ours = blue tint; Theirs = green tint; tuned to be readable but not intense. -->
        <SolidColorBrush x:Key="OursHighlightBrush" Color="#1A2B4A6E"/>
        <SolidColorBrush x:Key="TheirsHighlightBrush" Color="#1A1A5035"/>
        <SolidColorBrush x:Key="PaneForegroundBrush" Color="#E4E4E4"/>
        <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1E1E1E"/>
    </Window.Resources>
    <Grid Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header: source → target branches -->
            <RowDefinition Height="*"/>      <!-- Main content -->
            <RowDefinition Height="Auto"/>   <!-- Footer: commit buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>  <!-- File list -->
            <ColumnDefinition Width="*"/>    <!-- Panes -->
        </Grid.ColumnDefinitions>

        <!-- Header row -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Padding="16,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Merging " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SourceBranch}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text=" → " FontSize="14" VerticalAlignment="Center" Margin="6,0"/>
                <TextBlock Text="{Binding TargetBranch}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ResolvedFiles, StringFormat='{}{0} / '}" FontSize="13"/>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding TotalFiles, StringFormat='{}{0} files resolved'}" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- File list -->
        <Border Grid.Row="1" Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <ListBox AutomationProperties.AutomationId="Merge.ConflictFileList"
                     ItemsSource="{Binding Conflicts}"
                     SelectedItem="{Binding SelectedConflict}"
                     DisplayMemberPath="FilePath"
                     BorderThickness="0"
                     Background="Transparent"/>
        </Border>

        <!-- Main pane area: 2 input panes on top, result pane on bottom -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Connection-line overlay: zero-width canvas sitting between the
                 two input panes at row 0. The bezier curves map conflict
                 regions ours→theirs; pane scroll offsets are pushed in via
                 OursVerticalOffset / TheirsVerticalOffset bindings below. -->
            <merge:PaneConnectionCanvas x:Name="ConnectionCanvas"
                                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                        AutomationProperties.AutomationId="Merge.ConnectionCanvas"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="100"
                                        Layout="{Binding Layout}"
                                        Regions="{Binding Document.Ranges}"
                                        RangeStates="{Binding RangeStates}"/>

            <!-- Ours pane -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,6"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <TextBlock Text="OURS" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource OursHighlightBrush}"/>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" x:Name="OursScrollViewer"
                                  Background="{StaticResource PaneBackgroundBrush}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  ScrollChanged="OnOursScrollChanged">
                        <merge:ReadOnlyMergePane x:Name="OursPane"
                                                 AutomationProperties.AutomationId="Merge.OursPane"
                                                 Side="Ours"
                                                 Lines="{Binding OursLines}"
                                                 Regions="{Binding Document.Ranges}"
                                                 RangeStates="{Binding RangeStates}"
                                                 WordDiffs="{Binding OursWordDiffs}"
                                                 Layout="{Binding Layout}"
                                                 Foreground="{StaticResource PaneForegroundBrush}"
                                                 HighlightBrush="{StaticResource OursHighlightBrush}"
                                                 AcceptCheckboxToggled="OnOursCheckboxToggled"/>
                    </ScrollViewer>
                    <merge:ConflictMinimap Grid.Column="1"
                                           x:Name="OursMinimap"
                                           AutomationProperties.AutomationId="Merge.OursMinimap"
                                           Side="Ours"
                                           LineCount="{Binding OursLines.Count, FallbackValue=0}"
                                           Regions="{Binding Document.Ranges}"
                                           RangeStates="{Binding RangeStates}"
                                           Layout="{Binding Layout}"
                                           JumpRequested="OnOursMinimapJump"/>
                </Grid>
            </Grid>

            <!-- Theirs pane -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,6"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <TextBlock Text="THEIRS" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource TheirsHighlightBrush}"/>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" x:Name="TheirsScrollViewer"
                                  Background="{StaticResource PaneBackgroundBrush}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  ScrollChanged="OnTheirsScrollChanged">
                        <merge:ReadOnlyMergePane x:Name="TheirsPane"
                                                 AutomationProperties.AutomationId="Merge.TheirsPane"
                                                 Side="Theirs"
                                                 Lines="{Binding TheirsLines}"
                                                 Regions="{Binding Document.Ranges}"
                                                 RangeStates="{Binding RangeStates}"
                                                 WordDiffs="{Binding TheirsWordDiffs}"
                                                 Layout="{Binding Layout}"
                                                 Foreground="{StaticResource PaneForegroundBrush}"
                                                 HighlightBrush="{StaticResource TheirsHighlightBrush}"
                                                 AcceptCheckboxToggled="OnTheirsCheckboxToggled"/>
                    </ScrollViewer>
                    <merge:ConflictMinimap Grid.Column="1"
                                           x:Name="TheirsMinimap"
                                           AutomationProperties.AutomationId="Merge.TheirsMinimap"
                                           Side="Theirs"
                                           LineCount="{Binding TheirsLines.Count, FallbackValue=0}"
                                           Regions="{Binding Document.Ranges}"
                                           RangeStates="{Binding RangeStates}"
                                           Layout="{Binding Layout}"
                                           JumpRequested="OnTheirsMinimapJump"/>
                </Grid>
            </Grid>

            <!-- Result pane spanning both columns -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,6"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <TextBlock Text="RESULT" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <merge:ResultPane Grid.Row="1"
                                      AutomationProperties.AutomationId="Merge.ResultPane"
                                      Text="{Binding ComposedText, Mode=OneWay}"
                                      Layout="{Binding Layout}"
                                      ResultTextChanged="OnResultTextChanged"/>
                </Grid>
            </Border>

            <!-- Engine-error overlay -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Visibility="{Binding IsEngineError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                    <ic:SymbolIcon Symbol="ErrorCircle" FontSize="48"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="Merge engine could not process this file"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock Text="{Binding EngineErrorMessage}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Padding="16,8" Margin="0,0,8,0" Command="{Binding UseOursCommand}">
                            <TextBlock Text="Use Ours"/>
                        </Button>
                        <Button Padding="16,8" Command="{Binding UseTheirsCommand}">
                            <TextBlock Text="Use Theirs"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Binary-file overlay -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Visibility="{Binding IsBinaryConflict, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="DocumentError" FontSize="48"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="Binary file — choose a version" FontSize="16"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Padding="16,8" Margin="0,0,8,0" Command="{Binding UseOursCommand}">
                            <TextBlock Text="Use Ours"/>
                        </Button>
                        <Button Padding="16,8" Command="{Binding UseTheirsCommand}">
                            <TextBlock Text="Use Theirs"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Padding="16,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.UndoButton">
                        <TextBlock Text="Undo"/>
                    </Button>
                    <Button Command="{Binding RedoCommand}" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.RedoButton">
                        <TextBlock Text="Redo"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding AcceptAllOursCommand}" Margin="0,0,8,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.AcceptAllOurs">
                        <TextBlock Text="Accept All Ours"/>
                    </Button>
                    <Button Command="{Binding AcceptAllTheirsCommand}" Margin="0,0,16,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.AcceptAllTheirs">
                        <TextBlock Text="Accept All Theirs"/>
                    </Button>
                    <Button Command="{Binding MarkResolvedCommand}" Margin="0,0,8,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.MarkResolved">
                        <TextBlock Text="Mark Resolved"/>
                    </Button>
                    <Button Command="{Binding CompleteMergeCommand}" Padding="12,6"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            AutomationProperties.AutomationId="Merge.CompleteMerge">
                        <TextBlock Text="Complete Merge"/>
                    </Button>
                    <Button Command="{Binding AbortMergeCommand}" Margin="8,0,0,0" Padding="12,6"
                            AutomationProperties.AutomationId="Merge.AbortMerge">
                        <TextBlock Text="Abort"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
