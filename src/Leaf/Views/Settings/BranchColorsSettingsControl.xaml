<UserControl x:Class="Leaf.Views.Settings.BranchColorsSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Leaf.Converters">
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Branch Colours"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Choose the palette that drives auto-assigned branch colours, and manage your custom palettes."
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Active palette -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Active palette"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,12"/>

                <ComboBox x:Name="PaletteComboBox"
                          MinWidth="280"
                          HorizontalAlignment="Left"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="PaletteComboBox_SelectionChanged"/>

                <TextBlock Text="Preview"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,16,0,6"/>
                <ItemsControl x:Name="ActiveSwatchPreview">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="32"
                                    Height="32"
                                    Margin="0,0,4,4"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    ToolTip="{Binding Hex}"
                                    Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Custom palettes management -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Custom palettes"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Button Grid.Column="1"
                            Content="New from active…"
                            ToolTip="Create a new custom palette by cloning the active palette"
                            Click="NewCustomFromActive_Click"/>
                </Grid>

                <TextBlock x:Name="NoCustomPalettesText"
                           Text="You haven't created any custom palettes yet. Click 'New from active' to clone the current palette and edit it."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="Visible"
                           Margin="0,0,0,8"/>

                <ItemsControl x:Name="CustomPalettesItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Swatches}"
                                                      Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="20"
                                                            Height="20"
                                                            Margin="0,0,3,0"
                                                            CornerRadius="3"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            ToolTip="{Binding Hex}"
                                                            Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Edit…"
                                            Tag="{Binding}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Click="EditCustom_Click"/>
                                    <Button Grid.Column="2"
                                            Content="Delete"
                                            Tag="{Binding}"
                                            VerticalAlignment="Center"
                                            Click="DeleteCustom_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
