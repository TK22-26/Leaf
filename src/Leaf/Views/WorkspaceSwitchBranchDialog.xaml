<Window x:Class="Leaf.Views.WorkspaceSwitchBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Leaf.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:WorkspaceSwitchBranchDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Switch workspace to branch"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Switch workspace to branch"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,12">
                Every repo in the workspace will check out this branch. Repos that don't have the branch are skipped; the summary toast lists which.
            </TextBlock>
            <TextBlock Text="Branch name" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="BranchInput"
                     Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6"
                     FontFamily="Consolas"
                     AutomationProperties.AutomationId="WorkspaceSwitchBranchDialog.Input" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Padding="20,8"
                    MinWidth="100"
                    IsCancel="True"
                    Margin="0,0,12,0"
                    Click="Cancel_Click" />
            <Button Content="Switch"
                    Padding="20,8"
                    MinWidth="100"
                    IsDefault="True"
                    IsEnabled="{Binding CanSwitch}"
                    Click="Switch_Click"
                    AutomationProperties.AutomationId="WorkspaceSwitchBranchDialog.Switch" />
        </StackPanel>
    </Grid>
</Window>
