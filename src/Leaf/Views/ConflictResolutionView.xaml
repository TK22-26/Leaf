<Window x:Class="Leaf.Views.ConflictResolutionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Leaf.ViewModels"
        xmlns:controls="clr-namespace:Leaf.Controls"
        xmlns:mergecontrols="clr-namespace:Leaf.Controls.Merge"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:converters="clr-namespace:Leaf.Converters"
        d:DataContext="{d:DesignInstance Type=viewmodels:ConflictResolutionViewModel}"
        mc:Ignorable="d"
        Title="Resolve Merge Conflicts"
        Height="700"
        Width="1200"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        AutomationProperties.AutomationId="ConflictResolutionWindow">

    <Window.InputBindings>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding PreviousRegionConflictCommand}"/>
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding NextRegionConflictCommand}"/>
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding AcceptAllOursCommand}"/>
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding AcceptAllTheirsCommand}"/>
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding AcceptAllBothCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding MarkResolvedCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Semantic color resources — desaturated for modern IDE feel -->
        <SolidColorBrush x:Key="OursAccentBrush" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="OursAccentLightBrush" Color="#552B4A6E"/>
        <SolidColorBrush x:Key="OursForegroundBrush" Color="#C0D4EC"/>
        <SolidColorBrush x:Key="TheirsAccentBrush" Color="#1A5035"/>
        <SolidColorBrush x:Key="TheirsAccentLightBrush" Color="#551A5035"/>
        <SolidColorBrush x:Key="TheirsForegroundBrush" Color="#B8E8CE"/>
        <SolidColorBrush x:Key="MergedAccentBrush" Color="#6D28D9"/>
        <SolidColorBrush x:Key="MergedForegroundBrush" Color="#D0C4F0"/>
        <SolidColorBrush x:Key="ResolvedAccentBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="BothAccentBrush" Color="#0E7490"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E5A220"/>
        <SolidColorBrush x:Key="ManualAccentBrush" Color="#6D28D9"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>

        <Style x:Key="RegionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Colored region button variants -->
        <Style x:Key="RegionOursButtonStyle" TargetType="Button" BasedOn="{StaticResource RegionActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource OursAccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OursForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#3388BBEE"/>
        </Style>
        <Style x:Key="RegionTheirsButtonStyle" TargetType="Button" BasedOn="{StaticResource RegionActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource TheirsAccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TheirsForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#3366CC88"/>
        </Style>
        <Style x:Key="RegionBothButtonStyle" TargetType="Button" BasedOn="{StaticResource RegionActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BothAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3322BBDD"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Panes -->
            <RowDefinition Height="Auto"/>  <!-- Action bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar — [filename + progress | nav | resolution | utility] -->
        <Border Grid.Row="0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="6,3"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Left: progress indicators -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="3" Padding="8,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding RegionProgressPercent, Mode=OneWay}"
                                         Width="44" Height="6"
                                         Minimum="0" Maximum="100"
                                         Foreground="{StaticResource ResolvedAccentBrush}"/>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <Run Text="{Binding CurrentFileResolvedRegionCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding CurrentFileRegionCount, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text=" regions" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: all action groups -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Navigation -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,2,0">
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding PreviousRegionConflictCommand}"
                                ToolTip="Previous conflict (Alt+Up)" Padding="4,0">
                            <ic:SymbolIcon Symbol="ChevronUp" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding NextRegionConflictCommand}"
                                ToolTip="Next conflict (Alt+Down)" Padding="4,0">
                            <ic:SymbolIcon Symbol="ChevronDown" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Margin="4,5" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                    <!-- Resolution -->
                    <StackPanel Orientation="Horizontal" Margin="2,0">
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding AcceptAllOursCommand}"
                                Background="{StaticResource OursAccentBrush}"
                                Foreground="{StaticResource OursForegroundBrush}"
                                ToolTip="Accept all from current branch (Alt+1)">
                            <TextBlock Text="Ours" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding AcceptAllTheirsCommand}"
                                Background="{StaticResource TheirsAccentBrush}"
                                Foreground="{StaticResource TheirsForegroundBrush}"
                                ToolTip="Accept all from incoming branch (Alt+2)">
                            <TextBlock Text="Theirs" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding AcceptAllBothCommand}"
                                Background="{StaticResource BothAccentBrush}"
                                Foreground="White"
                                ToolTip="Insert ours, then theirs (Alt+3)">
                            <TextBlock Text="Both" FontSize="11"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Margin="4,5" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                    <!-- Utility -->
                    <StackPanel Orientation="Horizontal" Margin="2,0">
                        <ToggleButton IsChecked="{Binding IsSyncScrollEnabled}"
                                      Height="26" MinHeight="26" Padding="6,0"
                                      VerticalAlignment="Center" Margin="1,0"
                                      ToolTip="Synchronized scrolling"
                                      AutomationProperties.AutomationId="SyncScrollToggle">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ResolvedAccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <ic:SymbolIcon Symbol="LinkMultiple" FontSize="12"/>
                        </ToggleButton>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding UndoCommand}"
                                IsEnabled="{Binding CanUndo}"
                                ToolTip="Undo (Ctrl+Z)"
                                AutomationProperties.AutomationId="UndoButton">
                            <ic:SymbolIcon Symbol="ArrowUndo" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding RedoCommand}"
                                IsEnabled="{Binding CanRedo}"
                                ToolTip="Redo (Ctrl+Y)"
                                AutomationProperties.AutomationId="RedoButton">
                            <ic:SymbolIcon Symbol="ArrowRedo" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Center spacer (DockPanel fills remaining) -->
                <Border/>
            </DockPanel>
        </Border>

        <!-- Row 2: Main panes -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Normal merge view (hidden when binary or large file) -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                  Visibility="{Binding IsBinaryConflict, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid>
                    <Grid Visibility="{Binding IsLargeFile, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ours pane -->
                        <Border Grid.Row="0" Grid.Column="0"
                                CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Margin="0,0,4,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="8,3"
                                        Background="{StaticResource OursAccentLightBrush}"
                                        CornerRadius="6,6,0,0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="Ours" FontWeight="SemiBold" Foreground="{StaticResource OursForegroundBrush}"/>
                                        <Run Text=" (current branch)" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                </Border>
                                <mergecontrols:ConflictSideEditorControl x:Name="OursEditor"
                                                                         Grid.Row="1"
                                                                         Side="Ours"/>
                            </Grid>
                        </Border>

                        <!-- Theirs pane -->
                        <Border Grid.Row="0" Grid.Column="1"
                                CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Margin="4,0,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="8,3"
                                        Background="{StaticResource TheirsAccentLightBrush}"
                                        CornerRadius="6,6,0,0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="Theirs" FontWeight="SemiBold" Foreground="{StaticResource TheirsForegroundBrush}"/>
                                        <Run Text=" (incoming)" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                </Border>
                                <mergecontrols:ConflictSideEditorControl x:Name="TheirsEditor"
                                                                         Grid.Row="1"
                                                                         Side="Theirs"/>
                            </Grid>
                        </Border>

                        <!-- Merged Result -->
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="8,3"
                                        Background="#446D28D9"
                                        CornerRadius="6,6,0,0"
                                        BorderBrush="#336D28D9"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="Merged result" FontWeight="SemiBold" Foreground="{StaticResource MergedForegroundBrush}"/>
                                        <Run Text=" (editable)" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                </Border>
                                <controls:MergedResultEditorControl x:Name="MergedEditor" Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Large file warning overlay -->
                    <Border Visibility="{Binding IsLargeFile, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="6"
                            Padding="40">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Warning" FontSize="48" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,8">
                                <Run Text="Large file — "/><Run Text="{Binding LargeFileLineCount, Mode=OneWay}"/><Run Text=" lines"/>
                            </TextBlock>
                            <TextBlock Text="Consider resolving in VS Code for better performance."
                                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Padding="16,8" Margin="0,0,8,0"
                                        Command="{Binding ContinueLargeFileLoadCommand}">
                                    <TextBlock Text="Continue Anyway"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Binary file panel (shown when binary) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Visibility="{Binding IsBinaryConflict, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6"
                    Padding="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="DocumentError" FontSize="48"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="Binary file — choose a version"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock Text="This file contains binary content and cannot be merged line-by-line."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Padding="16,8" Margin="0,0,8,0"
                                Command="{Binding UseOursCommand}"
                                Background="{StaticResource OursAccentBrush}"
                                Foreground="{StaticResource OursForegroundBrush}">
                            <TextBlock Text="Use Ours"/>
                        </Button>
                        <Button Padding="16,8"
                                Command="{Binding UseTheirsCommand}"
                                Background="{StaticResource TheirsAccentBrush}"
                                Foreground="{StaticResource TheirsForegroundBrush}">
                            <TextBlock Text="Use Theirs"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Engine error overlay (shown when the merge engine refused the file) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Visibility="{Binding IsEngineError, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6"
                    Padding="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                    <ic:SymbolIcon Symbol="ErrorCircle" FontSize="48"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="Merge engine could not process this file"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock Text="{Binding EngineErrorMessage}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="You can still resolve this file using an external merge tool or by choosing a side."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Padding="16,8" Margin="0,0,8,0"
                                Command="{Binding UseOursCommand}"
                                Background="{StaticResource OursAccentBrush}"
                                Foreground="{StaticResource OursForegroundBrush}">
                            <TextBlock Text="Use Ours"/>
                        </Button>
                        <Button Padding="16,8"
                                Command="{Binding UseTheirsCommand}"
                                Background="{StaticResource TheirsAccentBrush}"
                                Foreground="{StaticResource TheirsForegroundBrush}">
                            <TextBlock Text="Use Theirs"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Footer — status + action -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="10,4"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Conflict navigation label -->
                <TextBlock Grid.Column="0"
                           Text="{Binding ConflictNavigationLabel}"
                           FontSize="11" FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Resolve File button -->
                <Button Grid.Column="2"
                        Command="{Binding MarkResolvedCommand}"
                        Padding="16,5"
                        IsEnabled="{Binding CanMarkResolved}"
                        AutomationProperties.AutomationId="ResolveFileButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanMarkResolved}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ResolvedAccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Resolve File" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.RowSpan="3"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="Loading conflicts..."
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
