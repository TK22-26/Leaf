<UserControl
    x:Class="Leaf.Views.CreatePullRequestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Leaf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <!--  Submitting overlay  -->
        <Grid
            Panel.ZIndex="10"
            Background="#80000000"
            Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="200"
                    Height="4"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="Creating pull request..." />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="16,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="#8250DF"
                            Symbol="BranchRequest" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Create Pull Request" />
                    </StackPanel>
                    <TextBlock
                        Margin="26,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Open a pull request to propose merging your changes into another branch." />
                </StackPanel>
            </Border>

            <!--  Form  -->
            <ScrollViewer
                Grid.Row="1"
                Padding="24,16"
                VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700">
                    <!--  Error message  -->
                    <Border
                        Margin="0,0,0,12"
                        Padding="10,8"
                        Background="#33CF222E"
                        CornerRadius="4"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock
                            FontSize="12"
                            Foreground="#CF222E"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Source branch  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Source branch" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="The branch that contains your changes." />
                    <ComboBox
                        Margin="0,0,0,16"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        ItemsSource="{Binding AvailableBranches}"
                        Text="{Binding SourceBranch, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Target branch  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Target branch" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="The branch you want to merge into." />
                    <ComboBox
                        Margin="0,0,0,16"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        ItemsSource="{Binding AvailableBranches}"
                        Text="{Binding TargetBranch, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Title  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Title" />
                    <TextBox
                        Margin="0,0,0,16"
                        Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Description  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Description" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Explain what your changes do and why. Supports Markdown." />
                    <TextBox
                        Height="150"
                        Margin="0,0,0,16"
                        AcceptsReturn="True"
                        Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                    <!--  Reviewers  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Reviewers" />
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Search for collaborators or teams by name. Click a result to add them." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupportsRequiredReviewers}" Value="True">
                                        <Setter Property="Text" Value="Search for collaborators or teams by name. Click a result to add them. Click Required/Optional to toggle." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  Selected reviewers  -->
                    <ItemsControl
                        Margin="0,0,0,4"
                        ItemsSource="{Binding SelectedReviewers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,4,4"
                                    Padding="6,3"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <ic:SymbolIcon
                                            Margin="0,0,4,0"
                                            FontSize="10"
                                            Symbol="Person" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="{Binding DisplayName}" />
                                        <!--  Required/Optional toggle (Azure DevOps only)  -->
                                        <Button
                                            Margin="4,0,0,0"
                                            Padding="4,1"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.ToggleReviewerRequiredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Visibility="{Binding DataContext.SupportsRequiredReviewers, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock FontSize="9" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Optional" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                                <Setter Property="Text" Value="Required" />
                                                                <Setter Property="Foreground" Value="#D29922" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button
                                            Margin="4,0,0,0"
                                            Padding="2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.RemoveReviewerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                            <ic:SymbolIcon FontSize="10" Symbol="Dismiss" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Reviewer search  -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            KeyDown="ReviewerSearch_KeyDown"
                            Text="{Binding ReviewerSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Padding="8,4"
                            Command="{Binding SearchReviewersCommand}"
                            Content="Search"
                            IsEnabled="{Binding IsSearchingReviewers, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>

                    <!--  Search loading indicator  -->
                    <ProgressBar
                        Height="2"
                        Margin="0,0,0,4"
                        IsIndeterminate="True"
                        Visibility="{Binding IsSearchingReviewers, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  Search status message (no results / errors)  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="11"
                        FontStyle="Italic"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding ReviewerSearchStatus}"
                        TextWrapping="Wrap"
                        Visibility="{Binding ReviewerSearchStatus, Converter={StaticResource NullToVisibilityConverter}}" />

                    <!--  Reviewer search results  -->
                    <ItemsControl
                        Margin="0,0,0,12"
                        ItemsSource="{Binding ReviewerSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,1"
                                    Padding="8,6"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ReviewerResult_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ic:SymbolIcon
                                            Margin="0,0,6,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Symbol="Person" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding SecondaryText}"
                                            Visibility="{Binding SecondaryText, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Draft toggle  -->
                    <CheckBox
                        Margin="0,0,0,4"
                        Content="Create as draft"
                        IsChecked="{Binding IsDraft}"
                        Visibility="{Binding SupportsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock
                        Margin="20,0,0,8"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Draft pull requests cannot be merged until marked as ready for review."
                        Visibility="{Binding SupportsDraft, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>

            <!--  Footer buttons  -->
            <Border
                Grid.Row="2"
                Padding="24,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="16,6"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
                    <Button
                        Padding="16,6"
                        Background="#28A745"
                        Command="{Binding SubmitCommand}"
                        Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <ic:SymbolIcon
                                Margin="0,0,4,0"
                                FontSize="12"
                                Symbol="Add" />
                            <TextBlock Text="Create Pull Request" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
