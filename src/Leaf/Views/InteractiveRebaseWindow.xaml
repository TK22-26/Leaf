<Window x:Class="Leaf.Views.InteractiveRebaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Leaf.ViewModels"
        xmlns:models="clr-namespace:Leaf.Models"
        xmlns:converters="clr-namespace:Leaf.Converters"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Interactive Rebase"
        Width="980"
        Height="640"
        MinWidth="780"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Per-action accent colours used by the action chip in each row.
             Match the §8 V3 status-pill palette intent: Pick is neutral,
             rewrite-history actions are amber, Drop is red, Exec is
             a different blue/cyan to signal "side-effect" semantics. -->
        <SolidColorBrush x:Key="ActionBrushPick"   Color="#3B82F6"/>
        <SolidColorBrush x:Key="ActionBrushReword" Color="#F59E0B"/>
        <SolidColorBrush x:Key="ActionBrushEdit"   Color="#F59E0B"/>
        <SolidColorBrush x:Key="ActionBrushSquash" Color="#A855F7"/>
        <SolidColorBrush x:Key="ActionBrushFixup"  Color="#A855F7"/>
        <SolidColorBrush x:Key="ActionBrushDrop"   Color="#DC2626"/>
        <SolidColorBrush x:Key="ActionBrushExec"   Color="#06B6D4"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Strikethrough subject when Action == Drop so the visual matches
             "this commit will not survive the rebase" without forcing the
             user to read the action label. -->
        <Style x:Key="SubjectText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropped}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShortShaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Consolas, Cascadia Mono"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Row toolbar icon buttons. Mirrors the BranchListView pattern:
             transparent fill, no border, foreground set explicitly so the
             FluentIcon renders with theme-correct contrast (the default
             ContentPresenter inherits Foreground from the system Control
             template which can be invisible on the dark Fluent surface). -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hover"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enum source for the action ComboBox. ObjectDataProvider lets
             WPF resolve Enum.GetValues at parse time without a converter. -->
        <ObjectDataProvider x:Key="RebaseActionValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:RebaseTodoAction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header card: title + summary + warning banner -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ic:SymbolIcon Grid.Column="0"
                               Symbol="ArrowSwap"
                               FontSize="20"
                               IconVariant="Filled"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Interactive Rebase"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding HeaderSummary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsRebasing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Running…"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Plan body: scrollable list of rows -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="0">
            <Grid>
                <!-- Empty / loading / error state. We layer all three on
                     top of the list so they fade in/out naturally; the
                     ItemsControl underneath stays bound and keeps scroll
                     position when transitioning out of an error. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Plan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RebaseTodoItem}">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- action dropdown -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- short SHA -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- subject -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- per-row controls -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- inline editor (reword/squash/exec) -->
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Action accent stripe — 4 px coloured bar that
                                             tells the eye what verb a row uses without
                                             reading the dropdown. Colour comes from a
                                             DataTrigger pyramid so we don't need a converter. -->
                                        <Rectangle Grid.Column="0" Grid.RowSpan="2"
                                                   Width="4" Margin="0,0,12,0"
                                                   RadiusX="2" RadiusY="2">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource ActionBrushPick}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}" Value="Reword">
                                                            <Setter Property="Fill" Value="{StaticResource ActionBrushReword}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Edit">
                                                            <Setter Property="Fill" Value="{StaticResource ActionBrushEdit}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Squash">
                                                            <Setter Property="Fill" Value="{StaticResource ActionBrushSquash}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Fixup">
                                                            <Setter Property="Fill" Value="{StaticResource ActionBrushFixup}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Drop">
                                                            <Setter Property="Fill" Value="{StaticResource ActionBrushDrop}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Exec">
                                                            <Setter Property="Fill" Value="{StaticResource ActionBrushExec}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <ComboBox Grid.Column="1" Grid.Row="0"
                                                  Width="100"
                                                  Margin="0,0,14,0"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding Source={StaticResource RebaseActionValues}}"
                                                  SelectedItem="{Binding Action, Mode=TwoWay}"
                                                  ToolTip="Action git will take on this commit"/>

                                        <TextBlock Grid.Column="2" Grid.Row="0"
                                                   Style="{StaticResource ShortShaText}"
                                                   Text="{Binding ShortSha}"/>

                                        <TextBlock Grid.Column="3" Grid.Row="0"
                                                   Style="{StaticResource SubjectText}"
                                                   Text="{Binding Subject}"/>

                                        <!-- Row toolbar: move up / down / insert exec / remove -->
                                        <StackPanel Grid.Column="4" Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowIconButton}"
                                                    ToolTip="Move up"
                                                    Command="{Binding DataContext.MoveItemUpCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ic:SymbolIcon Symbol="ArrowUp" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    ToolTip="Move down"
                                                    Command="{Binding DataContext.MoveItemDownCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ic:SymbolIcon Symbol="ArrowDown" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    ToolTip="Insert exec command after this row"
                                                    Command="{Binding DataContext.InsertExecAfterCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ic:SymbolIcon Symbol="Play" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconButton}"
                                                    ToolTip="Remove inserted exec row"
                                                    Visibility="{Binding IsExec, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ic:SymbolIcon Symbol="Delete" FontSize="14"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Inline editor: reword/squash message OR exec command. -->
                                        <Border Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="10,8"
                                                Visibility="{Binding IsRewordOrSquash,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="New commit message"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="60"
                                                         MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto"
                                                         FontFamily="JetBrains Mono, Consolas, Cascadia Mono"
                                                         FontSize="12"
                                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                         BorderThickness="1"/>
                                                <TextBlock Text="Leave blank to keep the original message."
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="10,8"
                                                Visibility="{Binding IsExec,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Shell command to run during rebase"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding ExecCommand, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="JetBrains Mono, Consolas, Cascadia Mono"
                                                         FontSize="12"/>
                                                <TextBlock Text="Non-zero exit pauses the rebase. Use carefully."
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading overlay — covers the list area only -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="3"/>
                        <TextBlock Text="Loading commits…"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Error overlay -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Padding="40"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="ErrorCircle"
                                       FontSize="32"
                                       IconVariant="Filled"
                                       Foreground="#DC2626"
                                       HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="520"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Footer: status text + action buttons -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Padding="20,8"
                            MinWidth="96"
                            Margin="0,0,10,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="Start Rebase"
                            Padding="20,8"
                            MinWidth="120"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding StartCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
