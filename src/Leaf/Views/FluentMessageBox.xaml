<Window x:Class="Leaf.Views.FluentMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Leaf.ViewModels"
        xmlns:models="clr-namespace:Leaf.Models"
        xmlns:converters="clr-namespace:Leaf.Converters"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        d:DataContext="{d:DesignInstance Type=viewmodels:FluentMessageBoxViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="560"
        MinWidth="480"
        MaxWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="FluentMessageBox">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <!-- Two-row outer Grid: content on top, footer (button strip with a
         hairline separator) below. Footer Background stays transparent so
         Mica reads through, matching the Win11 task-dialog look the user
         asked for. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content area -->
        <Grid Grid.Row="0" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Severity icon. Foreground is driven by the Icon enum so
                 the same SymbolIcon control covers all four severities;
                 the FluentIcons set already gives us the right glyph
                 shape, only the colour needs to change. -->
            <ic:SymbolIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                           Symbol="{Binding IconSymbol}"
                           FontSize="40"
                           VerticalAlignment="Top"
                           Margin="0,0,16,0"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                <ic:SymbolIcon.Style>
                    <Style TargetType="ic:SymbolIcon">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Static models:FluentMessageBoxIcon.Information}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Static models:FluentMessageBoxIcon.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Static models:FluentMessageBoxIcon.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Static models:FluentMessageBoxIcon.Question}">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ic:SymbolIcon.Style>
            </ic:SymbolIcon>

            <!-- In-dialog SemiBold header — mirrors the OS title bar the
                 way MergeDialog / RebaseDialog already do, so callers get a
                 consistent look across every dialog the app shows. -->
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Message body. Wraps freely; the SizeToContent="Height" on
                 the Window grows the dialog around the message length. -->
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Top"/>

            <!-- "Don't show this again" checkbox. Hidden by default;
                 surfaced when the host explicitly enables it via
                 ShowDoNotShowAgain. -->
            <CheckBox Grid.Row="2" Grid.Column="1"
                      Margin="0,16,0,0"
                      Content="Don't show this again"
                      IsChecked="{Binding DoNotShowAgainChecked}"
                      Visibility="{Binding ShowDoNotShowAgain, Converter={StaticResource BoolToVisibilityConverter}}"
                      AutomationProperties.AutomationId="FluentMessageBox.DoNotShowAgain"/>
        </Grid>

        <!-- Footer: subtle 15%-black overlay so the section is visually
             distinct without flattening Mica. LayerFillColorDefault
             (#4C3A3A3A) tested as too opaque and suppressed the Mica
             backdrop entirely; a hand-rolled #26000000 reads as a soft
             darkening of the Mica chrome rather than a separate slab.
             DividerStroke is the right token for content/footer
             separators (CardStrokeColorDefault is #19000000, invisible
             on the dark surface). Buttons use a LEADING margin so when
             the trailing button is hidden, no phantom right-edge gap
             remains. -->
        <Border Grid.Row="1"
                Background="#26000000"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <!-- Windows button order (#37): affirmative/default renders
                 BEFORE the dismissive within the right-aligned group —
                 [Yes][No], [OK][Cancel], [Yes][No][Cancel]. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,12,10">
                <Button x:Name="YesButton"
                        Content="Yes"
                        Padding="24,8"
                        MinWidth="120"
                        Margin="16,0,0,0"
                        IsDefault="True"
                        Visibility="{Binding ShowYes, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="Yes_Click"
                        AutomationProperties.AutomationId="FluentMessageBox.Yes"/>
                <Button x:Name="NoButton"
                        Content="No"
                        Padding="24,8"
                        MinWidth="120"
                        Margin="16,0,0,0"
                        Visibility="{Binding ShowNo, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="No_Click"
                        AutomationProperties.AutomationId="FluentMessageBox.No"/>
                <Button x:Name="OkButton"
                        Content="OK"
                        Padding="24,8"
                        MinWidth="120"
                        Margin="16,0,0,0"
                        IsDefault="True"
                        Visibility="{Binding ShowOk, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="Ok_Click"
                        AutomationProperties.AutomationId="FluentMessageBox.Ok"/>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="24,8"
                        MinWidth="120"
                        Margin="16,0,0,0"
                        IsCancel="True"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="Cancel_Click"
                        AutomationProperties.AutomationId="FluentMessageBox.Cancel"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
