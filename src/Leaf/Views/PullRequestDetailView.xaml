<UserControl
    x:Class="Leaf.Views.PullRequestDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Leaf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="clr-namespace:Leaf.Behaviors"
    xmlns:models="clr-namespace:Leaf.Models"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:IntGreaterThanZeroToVisibilityConverter x:Key="IntGreaterThanZeroToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:PullRequestStateToColorConverter x:Key="StateToColorConverter" />
        <converters:PullRequestStateToTextConverter x:Key="StateToTextConverter" />
        <converters:MarkdownToFlowDocumentConverter x:Key="MarkdownConverter" />
    </UserControl.Resources>

    <Grid>
        <!--  Loading overlay  -->
        <Grid Panel.ZIndex="10" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="200"
                    Height="4"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="Loading pull request..." />
            </StackPanel>
        </Grid>

        <!--  Error state  -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <ic:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="#CF222E"
                Symbol="ErrorCircle" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Detail content  -->
        <Grid Visibility="{Binding Details, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="16,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Back button  -->
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        Click="BackButton_Click"
                        ToolTip="Back to graph">
                        <ic:SymbolIcon FontSize="14" Symbol="ArrowLeft" />
                    </Button>

                    <!--  Title row  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <!--  Display title (non-editing)  -->
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Details.Summary.Title}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <!--  Edit title  -->
                        <TextBox
                            Width="400"
                            FontSize="14"
                            Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="#" /><Run Text="{Binding Details.Summary.Number, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!--  Metadata row  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4,0,0"
                        Orientation="Horizontal">
                        <!--  State badge (dynamic)  -->
                        <Border
                            Padding="6,2"
                            Background="{Binding Details.Summary.State, Converter={StaticResource StateToColorConverter}}"
                            CornerRadius="10">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Details.Summary.State, Converter={StaticResource StateToTextConverter}}" />
                        </Border>
                        <!--  Draft badge  -->
                        <Border
                            Margin="4,0,0,0"
                            Padding="6,2"
                            Background="#6E7781"
                            CornerRadius="10"
                            Visibility="{Binding Details.Summary.IsDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Draft" />
                        </Border>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="{Binding Details.Summary.SourceBranch, Mode=OneWay}" />
                            <Run Text=" → " />
                            <Run Text="{Binding Details.Summary.TargetBranch, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="by " />
                            <Run Text="{Binding Details.Summary.AuthorLogin, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!--  Action buttons  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  Edit button (non-editing mode, open PRs only)  -->
                        <Button
                            Margin="4,0"
                            Padding="6,4"
                            Command="{Binding StartEditCommand}"
                            ToolTip="Edit title and description"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ic:SymbolIcon FontSize="12" Symbol="Edit" />
                        </Button>
                        <!--  Save/Cancel edit  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button
                                Margin="4,0"
                                Padding="8,4"
                                Command="{Binding SaveEditCommand}"
                                Content="Save" />
                            <Button
                                Margin="4,0"
                                Padding="8,4"
                                Command="{Binding CancelEditCommand}"
                                Content="Cancel" />
                        </StackPanel>
                        <!--  Merge button  -->
                        <Button
                            x:Name="MergeButton"
                            Margin="4,0"
                            Padding="8,4"
                            Click="MergeButton_Click"
                            IsEnabled="{Binding CanMerge}"
                            ToolTip="Merge pull request"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ic:SymbolIcon
                                    Margin="0,0,4,0"
                                    FontSize="12"
                                    Symbol="Merge" />
                                <TextBlock FontSize="11" Text="Merge" />
                            </StackPanel>
                        </Button>
                        <!--  Close button  -->
                        <Button
                            Margin="4,0"
                            Padding="8,4"
                            Click="CloseButton_Click"
                            ToolTip="Close without merging"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ic:SymbolIcon
                                    Margin="0,0,4,0"
                                    FontSize="12"
                                    Foreground="#CF222E"
                                    Symbol="DismissCircle" />
                                <TextBlock FontSize="11" Text="Close" />
                            </StackPanel>
                        </Button>
                        <!--  Open in browser  -->
                        <Button
                            Margin="4,0"
                            Padding="8,4"
                            Command="{Binding OpenInBrowserCommand}"
                            ToolTip="Open in browser">
                            <StackPanel Orientation="Horizontal">
                                <ic:SymbolIcon
                                    Margin="0,0,4,0"
                                    FontSize="12"
                                    Symbol="Open" />
                                <TextBlock FontSize="11" Text="Open in browser" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Body, files, reviews, comments, checks  -->
            <ScrollViewer
                Grid.Row="1"
                Padding="16"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--  Description (markdown)  -->
                    <RichTextBox
                        Margin="0,0,0,16"
                        behaviors:RichTextBoxHelper.Document="{Binding Details.Body, Converter={StaticResource MarkdownConverter}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        IsReadOnly="True"
                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <!--  Edit body  -->
                    <TextBox
                        Height="200"
                        Margin="0,0,0,16"
                        AcceptsReturn="True"
                        Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  Status Checks section  -->
                    <StackPanel Visibility="{Binding Details.StatusChecks.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Status Checks" />
                        <ItemsControl ItemsSource="{Binding Details.StatusChecks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PullRequestStatusCheckInfo}">
                                    <Border
                                        Margin="0,1"
                                        Padding="8,4"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="CheckItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ic:SymbolIcon
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                FontSize="14"
                                                Foreground="{Binding Status, Converter={StaticResource CheckStatusToColorConverter}}"
                                                Symbol="{Binding Status, Converter={StaticResource CheckStatusToIconConverter}}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,12" />
                    </StackPanel>

                    <!--  Files section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Run Text="Files changed (" /><Run Text="{Binding Details.Files.Count, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Details.Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PullRequestFileInfo}">
                                <Border
                                    Margin="0,1"
                                    Padding="8,4"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="FileItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--  Status indicator  -->
                                        <TextBlock
                                            x:Name="StatusIndicator"
                                            Grid.Column="0"
                                            Width="16"
                                            Margin="0,0,6,0"
                                            HorizontalAlignment="Center"
                                            FontFamily="Cascadia Code, Consolas, monospace"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="#28A745"
                                            Text="M" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="Cascadia Code, Consolas, monospace"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Path}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                FontSize="10"
                                                Foreground="#28A745">
                                                <Run Text="+" /><Run Text="{Binding Additions, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                FontSize="10"
                                                Foreground="#CF222E">
                                                <Run Text="-" /><Run Text="{Binding Deletions, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Added">
                                        <Setter TargetName="StatusIndicator" Property="Text" Value="A" />
                                        <Setter TargetName="StatusIndicator" Property="Foreground" Value="#28A745" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Modified">
                                        <Setter TargetName="StatusIndicator" Property="Text" Value="M" />
                                        <Setter TargetName="StatusIndicator" Property="Foreground" Value="#DBAB09" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                        <Setter TargetName="StatusIndicator" Property="Text" Value="D" />
                                        <Setter TargetName="StatusIndicator" Property="Foreground" Value="#CF222E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Renamed">
                                        <Setter TargetName="StatusIndicator" Property="Text" Value="R" />
                                        <Setter TargetName="StatusIndicator" Property="Foreground" Value="#8250DF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Copied">
                                        <Setter TargetName="StatusIndicator" Property="Text" Value="C" />
                                        <Setter TargetName="StatusIndicator" Property="Foreground" Value="#3B82F6" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Reviews section  -->
                    <StackPanel Visibility="{Binding Details.Reviews.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
                        <Separator Margin="0,12" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="Reviews (" /><Run Text="{Binding Details.Reviews.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Details.Reviews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PullRequestReviewInfo}">
                                    <Border
                                        Margin="0,2"
                                        Padding="8,6"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                Orientation="Horizontal">
                                                <ic:SymbolIcon
                                                    Margin="0,0,4,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Symbol="Person" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding ReviewerLogin}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Body}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Grid.Column="2"
                                                Padding="6,2"
                                                Background="{Binding State, Converter={StaticResource ReviewStateToColorConverter}}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding State, Converter={StaticResource ReviewStateToTextConverter}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  Comments section  -->
                    <StackPanel Visibility="{Binding Details.Comments.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
                        <Separator Margin="0,12" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="Comments (" /><Run Text="{Binding Details.Comments.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Details.Comments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PullRequestCommentInfo}">
                                    <Border
                                        Margin="0,2"
                                        Padding="10,8"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ic:SymbolIcon
                                                    Margin="0,0,4,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Symbol="Person" />
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding AuthorLogin}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy HH:mm}'}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    FontFamily="Cascadia Code, Consolas, monospace"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding FilePath}"
                                                    Visibility="{Binding FilePath, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Body}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  Requested Reviewers section  -->
                    <StackPanel Visibility="{Binding Details.RequestedReviewers.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}}">
                        <Separator Margin="0,12" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Requested Reviewers" />
                        <ItemsControl ItemsSource="{Binding Details.RequestedReviewers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                        <ic:SymbolIcon
                                            Margin="0,0,6,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Symbol="Person" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DisplayName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
